datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/control"
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
  previewFeatures = ["postgresqlExtensions"]
}

enum PrincipalTier {
  OPERATOR
  END_USER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OperatorIdentityProvider {
  MAGIC_LINK
  GITHUB
  GOOGLE
}

enum AuthRateLimitAction {
  LOGIN
  INVITE_ACCEPT
  MFA_VERIFY
}

enum ImpersonationAction {
  START
  STOP
}

enum ProjectRole {
  ADMIN
  EDITOR
  VIEWER
}

enum CredentialKind {
  SECRET_REFERENCE
  CHANNEL_SECRET
  ENTITY_SECRET
  SERVICE_CREDENTIAL
}

enum EnvironmentVariableKind {
  PLAIN
  SECRET
}

enum AlertChannelType {
  EMAIL
  SLACK
  WEBHOOK
}

enum AlertDeliveryKind {
  TEST
  BUDGET
}

enum AlertDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum ToolKind {
  ENTITY
  RUNTIME
  META
}

enum WorkStatus {
  PENDING
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AuthorizationScopeKind {
  GLOBAL
  ORGANIZATION
  PROJECT
  ENVIRONMENT
}

enum AgentToolDefaultPolicy {
  NONE
  ALL
}

enum AgentVersionBucket {
  CURRENT
  CANARY
}

enum ThreadCompactionState {
  IDLE
  IN_PROGRESS
}

enum ModelRateSource {
  LITELLM
  VERIFIED_PROVIDER
  UNAVAILABLE
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  displayName      String?
  platformOperator Boolean   @default(false)
  disabledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organizationMemberships OrganizationMembership[]
  invitationsSent         OrganizationInvitation[]  @relation("OrganizationInvitationInviter")
  invitationsAccepted     OrganizationInvitation[]  @relation("OrganizationInvitationAcceptor")
  identities              OperatorIdentity[]
  operatorSessions        OperatorSession[]         @relation("OperatorSessionActor")
  impersonatedSessions    OperatorSession[]         @relation("OperatorSessionTarget")
  mfaTotp                 OperatorMfaTotp?
  mfaRecoveryCodes        OperatorMfaRecoveryCode[]
  impersonationsStarted   ImpersonationAudit[]      @relation("ImpersonationActor")
  impersonationsReceived  ImpersonationAudit[]      @relation("ImpersonationTarget")
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthClientsRegistered  OAuthClient[]
  mcpTokensMinted         McpToken[]
  personalAccessTokens    PersonalAccessToken[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
  mcpBearerTokensCreated  McpBearerToken[]
}

model OperatorSession {
  id                 String        @id @default(uuid()) @db.Uuid
  tokenHash          String        @unique
  tier               PrincipalTier @default(OPERATOR)
  userId             String        @db.Uuid
  impersonatedUserId String?       @db.Uuid
  parentSessionId    String?       @db.Uuid
  mfaVerifiedAt      DateTime?
  expiresAt          DateTime
  revokedAt          DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime      @default(now())

  user                  User                 @relation("OperatorSessionActor", fields: [userId], references: [id], onDelete: Cascade)
  impersonatedUser      User?                @relation("OperatorSessionTarget", fields: [impersonatedUserId], references: [id], onDelete: Cascade)
  parentSession         OperatorSession?     @relation("OperatorSessionParent", fields: [parentSessionId], references: [id], onDelete: Cascade)
  childSessions         OperatorSession[]    @relation("OperatorSessionParent")
  environmentSessions   EnvironmentSession[]
  impersonationAuditLog ImpersonationAudit[]

  @@index([userId, expiresAt])
  @@index([impersonatedUserId, expiresAt])
  @@index([parentSessionId])
  @@index([expiresAt])
}

model OperatorIdentity {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @db.Uuid
  provider      OperatorIdentityProvider
  subject       String
  providerEmail String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([providerEmail])
}

model MagicLinkToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([expiresAt])
}

model OperatorMfaTotp {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @db.Uuid
  encryptedSecret        String?
  enabledAt              DateTime?
  lastUsedCounter        BigInt?
  pendingEncryptedSecret String?
  pendingExpiresAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OperatorMfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, consumedAt])
}

model AuthRateLimitBucket {
  id             String              @id @default(uuid()) @db.Uuid
  action         AuthRateLimitAction
  identifierHash String
  windowStart    DateTime
  attempts       Int                 @default(1)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([action, identifierHash, windowStart])
  @@index([expiresAt])
}

model ImpersonationAudit {
  id                     String              @id @default(uuid()) @db.Uuid
  action                 ImpersonationAction
  actorUserId            String              @db.Uuid
  targetUserId           String              @db.Uuid
  impersonationSessionId String              @db.Uuid
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime            @default(now())

  actor                User            @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target               User            @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  impersonationSession OperatorSession @relation(fields: [impersonationSessionId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([impersonationSessionId, createdAt])
}

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  slug       String    @unique
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships             OrganizationMembership[]
  invitations             OrganizationInvitation[]
  projects                Project[]
  endUsers                EndUser[]
  skills                  Skill[]
  mcpPolicies             OrganizationMcpPolicy[]
  oauthClients            OAuthClient[]
  erasureOperations       ErasureOperation[]
  erasureTombstones       ErasureTombstone[]
  personalAccessTokens    PersonalAccessToken[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthConsentTransactions OAuthConsentTransaction[]

  @@index([archivedAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  deactivatedAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMemberships ProjectMembership[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId, deactivatedAt])
  @@index([organizationId, role, deactivatedAt])
}

model OrganizationInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  inviterId        String?          @db.Uuid
  acceptedByUserId String?          @db.Uuid
  email            String
  role             OrganizationRole @default(MEMBER)
  tokenHash        String           @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("OrganizationInvitationInviter", fields: [inviterId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, email, expiresAt])
  @@index([inviterId])
  @@index([acceptedByUserId])
  @@index([expiresAt])
}

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  slug           String
  name           String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships             ProjectMembership[]
  environments            Environment[]
  agents                  Agent[]
  entities                Entity[]
  projectSkills           ProjectSkill[]
  personalAccessTokens    PersonalAccessToken[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthConsentTransactions OAuthConsentTransaction[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
}

model ProjectMembership {
  id                       String      @id @default(uuid()) @db.Uuid
  projectId                String      @db.Uuid
  organizationMembershipId String      @db.Uuid
  /// Integrity key: both composite FKs derive and verify this value.
  organizationId           String      @db.Uuid
  role                     ProjectRole @default(VIEWER)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  project                Project                @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMembership OrganizationMembership @relation(fields: [organizationMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([projectId, organizationMembershipId])
  @@index([organizationMembershipId])
  @@index([projectId, role])
}

model Environment {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  slug       String
  name       String
  archivedAt DateTime?
  memoryFeedbackBackfillCursor      String?   @db.Uuid
  memoryFeedbackBackfillCompletedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentSessions     EnvironmentSession[]
  endUserSessions         EndUserSession[]
  agentClusters           AgentCluster[]
  agentBindings           AgentBinding[]
  credentials             Credential[]
  credentialAudits        CredentialAudit[]
  environmentVariables     EnvironmentVariable[]
  alertChannels            AlertChannel[]
  budgetThresholdEvents    BudgetThresholdEvent[]
  alertDeliveries          AlertDelivery[]
  alertDeliveryAttempts    AlertDeliveryAttempt[]
  postmanTemplates        PostmanTemplate[]
  threads                 Thread[]
  artifacts               Artifact[]
  messageAttachments      MessageAttachment[]
  channelConnections      ChannelConnection[]
  channelApps             ChannelApp[]
  entityTools             EnvironmentEntityTool[]
  toolHealth              ToolHealth[]
  toolCallAudits          ToolCallAudit[]
  adminAudits             AdminAudit[]
  approvals               AgentApproval[]
  providers               EnvironmentProvider[]
  budgets                 Budget[]
  safetyEvents            SafetyEvent[]
  messageRatings          MessageRating[]
  evalCriteria            EvalCriterion[]
  agentEvals              AgentEval[]
  goldenSets              GoldenSet[]
  jobs                    Job[]
  environmentSkills       EnvironmentSkill[]
  memories                Memory[]
  memoryEntities          MemoryEntity[]
  memoryRelationships     MemoryRelationship[]
  macros                  Macro[]
  events                  Event[]
  notificationRules       NotificationRule[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthConsentTransactions OAuthConsentTransaction[]
  mcpAnonymousSessions    McpAnonymousSession[]
  mcpOidcSessions         McpOidcSession[]
  accessKeys              AccessKey[]
  providerKeys            ProviderKey[]
  mcpTokens               McpToken[]
  personalAccessTokens    PersonalAccessToken[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
  mcpBearerTokens         McpBearerToken[]
  entityToolPolicies      EntityToolPolicy[]

  @@unique([projectId, slug])
  @@index([projectId, archivedAt])
}

model EnvironmentSession {
  id                String        @id @default(uuid()) @db.Uuid
  environmentId     String        @db.Uuid
  operatorSessionId String        @db.Uuid
  tier              PrincipalTier @default(OPERATOR)
  ipAddress         String?
  userAgent         String?
  lastSeenAt        DateTime?
  endedAt           DateTime?
  createdAt         DateTime      @default(now())

  environment     Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  operatorSession OperatorSession @relation(fields: [operatorSessionId], references: [id], onDelete: Cascade)

  @@index([environmentId, endedAt])
  @@index([operatorSessionId, endedAt])
}

model EndUser {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  displayName    String?
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identities          EndUserIdentity[]
  threads             Thread[]
  memories            Memory[]
  toolCallAudits      ToolCallAudit[]
  safetyEvents        SafetyEvent[]
  messageRatings      MessageRating[]
  memoryEntities      MemoryEntity[]
  memoryRelationships MemoryRelationship[]
  messageAttachments  MessageAttachment[]

  @@unique([id, organizationId])
  @@index([organizationId, disabledAt])
}

model EndUserIdentity {
  id             String    @id @default(uuid()) @db.Uuid
  endUserId      String    @db.Uuid
  /// Integrity key used by the composite FK and organization-scoped identity key.
  organizationId String    @db.Uuid
  issuer         String
  channel        String
  subject        String
  /// Object root containing verified identity profile attributes; validated by jsonShapeRegistry.
  profile        Json?
  verifiedAt     DateTime?
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  endUser  EndUser          @relation(fields: [endUserId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sessions EndUserSession[]

  @@unique([organizationId, issuer, channel, subject])
  @@index([endUserId, disabledAt])
}

model EndUserSession {
  id            String        @id @default(uuid()) @db.Uuid
  identityId    String        @db.Uuid
  environmentId String        @db.Uuid
  tokenHash     String        @unique
  tier          PrincipalTier @default(END_USER)
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime      @default(now())

  /// The initial migration enforces that this identity and environment resolve
  /// to the same Organization. Scope is derived instead of copied here.
  identity    EndUserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  environment Environment     @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@index([identityId, expiresAt])
  @@index([environmentId, expiresAt])
  @@index([expiresAt])
}

model Agent {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions             AgentVersion[]
  bindings             AgentBinding[]
  postmanTemplates     PostmanTemplate[]
  threads              Thread[]
  approvals            AgentApproval[]
  budgets              Budget[]
  safetyEvents         SafetyEvent[]
  messageRatings       MessageRating[]
  evalCriteria         EvalCriterion[]
  agentEvals           AgentEval[]
  goldenSets           GoldenSet[]
  memories             Memory[]
  memoryEntities       MemoryEntity[]
  memoryRelationships  MemoryRelationship[]
  channelConnections   ChannelConnection[]
  channelApps          ChannelApp[]
  channelInstallations ChannelInstallation[]
  toolCallAudits       ToolCallAudit[]
  messageAttachments   MessageAttachment[]

  @@unique([projectId, slug])
  @@index([projectId, isActive])
}

model AgentCluster {
  id            String   @id @default(uuid()) @db.Uuid
  environmentId String   @db.Uuid
  name          String
  slug          String
  description   String?
  /// Object root. Arbitrary non-secret cluster labels; validated by jsonShapeRegistry.
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment         Environment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  bindings            AgentBinding[]
  threads             Thread[]
  memories            Memory[]
  memoryEntities      MemoryEntity[]
  memoryRelationships MemoryRelationship[]

  @@unique([environmentId, slug])
}

model AgentVersion {
  id                String                 @id @default(uuid()) @db.Uuid
  agentId           String                 @db.Uuid
  versionNumber     Int
  model             String
  systemPrompt      String?
  maxSteps          Int                    @default(10)
  contextLimit      Int                    @default(128000)
  /// Default for tools without an AgentToolPolicy row. NONE exposes no unlisted tools; ALL exposes every unlisted tool.
  toolDefaultPolicy AgentToolDefaultPolicy @default(NONE)
  /// Array root of PromptBlock objects. One legacy encoded layer is accepted by normalizePromptBlocks.
  promptBlocks      Json                   @default("[]")
  /// Array root of DynamicBlock objects. One legacy encoded layer is accepted by normalizeDynamicBlocks.
  dynamicBlocks     Json                   @default("[]")
  /// Object root containing typed tool-router settings. One legacy encoded layer is accepted by normalizeToolsBlockConfig.
  toolsBlockConfig  Json                   @default("{}")
  /// Array root of ModelRoute objects. One legacy encoded layer is accepted by normalizeModelRoutes.
  modelRoutes       Json                   @default("[]")
  /// Object root containing memory limits and visibility defaults; validated by jsonShapeRegistry.
  memoryConfig      Json                   @default("{}")
  /// Object root containing a JSON Schema for structured output; validated by jsonShapeRegistry.
  outputSchema      Json?
  note              String?
  createdBy         String
  createdAt         DateTime               @default(now())

  agent          Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activeBindings AgentBinding[]    @relation("ActiveAgentVersion")
  canaryBindings AgentBinding[]    @relation("CanaryAgentVersion")
  toolPolicies   AgentToolPolicy[]
  skills         AgentSkill[]
  messageRatings MessageRating[]
  agentEvals     AgentEval[]
  turns          Turn[]

  @@unique([agentId, versionNumber])
}

model AgentBinding {
  id                   String   @id @default(uuid()) @db.Uuid
  environmentId        String   @db.Uuid
  agentId              String   @db.Uuid
  activeAgentVersionId String   @db.Uuid
  canaryAgentVersionId String?  @db.Uuid
  clusterId            String?  @db.Uuid
  canaryPercent        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  environment        Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  agent              Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activeAgentVersion AgentVersion  @relation("ActiveAgentVersion", fields: [activeAgentVersionId], references: [id], onDelete: Restrict)
  canaryAgentVersion AgentVersion? @relation("CanaryAgentVersion", fields: [canaryAgentVersionId], references: [id], onDelete: Restrict)
  cluster            AgentCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@unique([environmentId, agentId])
  @@index([activeAgentVersionId])
  @@index([canaryAgentVersionId])
  @@index([clusterId])
}

model Credential {
  id                    String         @id @default(uuid()) @db.Uuid
  environmentId         String         @db.Uuid
  activeSecretVersionId String?        @db.Uuid
  kind                  CredentialKind
  name                  String
  prefix                String?
  /// Transitional non-provider verifier used by canonical wire transport authentication.
  secretHash            String?
  /// Transitional non-provider channel envelope; provider/MCP resolution must use secretVersions.
  encryptedReference    String?
  permissions           String[]       @default([])
  allowedOrigins        String[]       @default([])
  provider              String?
  externalClientId      String?
  expiresAt             DateTime?
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdBy             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  environment         Environment               @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  activeSecretVersion CredentialSecretVersion?  @relation("CredentialActiveSecretVersion", fields: [activeSecretVersionId, id], references: [id, credentialId], onDelete: Restrict)
  secretVersions      CredentialSecretVersion[] @relation("CredentialSecretVersions")
  credentialAudits           CredentialAudit[]
  providerKeys               ProviderKey[]
  environmentVariables       EnvironmentVariable[]
  alertChannelConfigurations AlertChannelConfiguration[]

  channelConnections   ChannelConnection[]
  channelApps          ChannelApp[]
  channelInstallations ChannelInstallation[]
  entityMcpClients     EntityMcpClient[]
  mcpOidcSessions      McpOidcSession[]

  @@unique([id, environmentId])
  @@unique([activeSecretVersionId, id])
  @@unique([environmentId, kind, name])
  @@index([environmentId, kind, revokedAt])
  @@index([activeSecretVersionId])
}

model EnvironmentVariable {
  id            String                  @id @default(uuid()) @db.Uuid
  environmentId String                  @db.Uuid
  key           String
  kind          EnvironmentVariableKind
  value         String?
  credentialId  String?                 @db.Uuid
  version       Int                     @default(1)
  lastUpdatedBy String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  credential  Credential? @relation(fields: [credentialId, environmentId], references: [id, environmentId], onDelete: Restrict)

  @@unique([environmentId, key])
  @@index([credentialId])
}

model CredentialSecretVersion {
  id             String    @id @default(uuid()) @db.Uuid
  credentialId   String    @db.Uuid
  secretRevision Int
  formatVersion  Int
  rootKeyVersion Int
  salt           Bytes
  nonce          Bytes
  ciphertext     Bytes
  authTag        Bytes
  retiredAt      DateTime?
  readableUntil  DateTime?
  createdAt      DateTime  @default(now())

  credential Credential  @relation("CredentialSecretVersions", fields: [credentialId], references: [id], onDelete: Restrict)
  activeFor  Credential? @relation("CredentialActiveSecretVersion")

  @@unique([id, credentialId])
  @@unique([credentialId, secretRevision, rootKeyVersion])
  @@index([credentialId, retiredAt])
  @@index([rootKeyVersion])
}

model CredentialAudit {
  id                 String   @id @default(uuid()) @db.Uuid
  environmentId      String   @db.Uuid
  credentialId       String   @db.Uuid
  action             String
  outcome            String
  actorType          String
  actorId            String
  effectiveUserId    String?
  secretRevision     Int?
  fromRootKeyVersion Int?
  toRootKeyVersion   Int?
  createdAt          DateTime @default(now())

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  credential  Credential  @relation(fields: [credentialId, environmentId], references: [id, environmentId], onDelete: Restrict)

  @@index([environmentId, createdAt])
  @@index([credentialId, createdAt])
}

model AccessKey {
  id             String    @id @default(uuid()) @db.Uuid
  environmentId  String    @db.Uuid
  keyPrefix      String
  keyHash        String    @unique
  allowedOrigins String[]  @default([])
  lastUsedAt     DateTime?
  validUntil     DateTime?
  replacedById   String?   @db.Uuid
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  replacedBy  AccessKey?  @relation("AccessKeyReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces    AccessKey[] @relation("AccessKeyReplacement")

  @@index([environmentId, revokedAt, validUntil])
  @@index([replacedById])
}

model ProviderKey {
  id                 String    @id @default(uuid()) @db.Uuid
  environmentId      String    @db.Uuid
  credentialId       String    @db.Uuid
  provider           String
  label              String
  environmentKeyName String
  /// The initial migration enforces at most one default per Environment/provider with a partial unique index.
  isDefault          Boolean   @default(false)
  createdBy          String
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  credential  Credential  @relation(fields: [credentialId, environmentId], references: [id, environmentId], onDelete: Restrict)

  @@unique([environmentId, provider, label])
  @@index([environmentId, provider, isDefault])
  @@index([credentialId])
}

model McpToken {
  id             String    @id @default(uuid()) @db.Uuid
  environmentId  String    @db.Uuid
  mintedByUserId String    @db.Uuid
  name           String
  tokenHash      String    @unique
  permissions    String[]
  tier           String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
