// ====================================================
// LLM Pricing Models
// ====================================================

/// A known LLM model or model pattern for cost tracking
model LlmModel {
  id           String    @id @default(cuid())
  friendlyId   String    @unique @map("friendly_id")
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelName    String    @map("model_name")
  matchPattern String    @map("match_pattern")
  startDate    DateTime? @map("start_date")
  source       String    @default("default") // "default", "admin", "project"
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Catalog metadata for model registry
  provider        String?  @map("provider")
  description     String?  @map("description")
  contextWindow   Int?     @map("context_window")
  maxOutputTokens Int?     @map("max_output_tokens")
  capabilities    String[] @default([]) @map("capabilities")
  isHidden        Boolean  @default(false) @map("is_hidden")
  baseModelName   String?  @map("base_model_name")

  pricingTiers LlmPricingTier[]
  prices       LlmPrice[]

  @@unique([projectId, modelName, startDate])
  @@index([projectId])
  @@map("llm_models")
}

/// A pricing tier for a model (supports volume-based or conditional pricing)
model LlmPricingTier {
  id         String   @id @default(cuid())
  modelId    String   @map("model_id")
  model      LlmModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name       String
  isDefault  Boolean  @default(true) @map("is_default")
  priority   Int      @default(0)
  conditions Json     @default("[]") @db.JsonB

  prices LlmPrice[]

  @@unique([modelId, priority])
  @@unique([modelId, name])
  @@map("llm_pricing_tiers")
}

/// A price point for a usage type within a pricing tier
model LlmPrice {
  id            String         @id @default(cuid())
  modelId       String         @map("model_id")
  model         LlmModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  pricingTierId String         @map("pricing_tier_id")
  pricingTier   LlmPricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)
  usageType     String         @map("usage_type")
  price         Decimal        @db.Decimal(20, 12)

  @@unique([modelId, usageType, pricingTierId])
  @@map("llm_prices")
}

enum PlatformNotificationSurface {
  WEBAPP
  CLI
}

enum PlatformNotificationScope {
  USER
  PROJECT
  ORGANIZATION
  GLOBAL
}

/// Admin-created notification definitions
model PlatformNotification {
  id String @id @default(cuid())

  friendlyId String @unique @default(cuid())

  /// Admin-facing title for identification in admin tools
  title String

  /// Versioned JSON rendering content (see payload schema in spec)
  payload Json

  surface PlatformNotificationSurface
  scope   PlatformNotificationScope

  /// Set when scope = USER
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String?

  /// Set when scope = ORGANIZATION
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String?

  /// Set when scope = PROJECT
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId String?

  /// When notification becomes active
  startsAt DateTime

  /// When notification expires
  endsAt DateTime

  /// CLI: auto-expire N days after user first saw it
  cliMaxDaysAfterFirstSeen Int?

  /// CLI: auto-expire after shown N times to user
  cliMaxShowCount Int?

  /// CLI: only show every N-th request (e.g. cliShowEvery=3 means show on 3rd, 6th, 9th…)
  cliShowEvery Int?

  /// Ordering within same scope level (higher = more important)
  priority Int @default(0)

  /// Soft delete
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions PlatformNotificationInteraction[]

  @@index([surface, scope, startsAt])
}

/// Per-user tracking of notification views and dismissals
model PlatformNotificationInteraction {
  id String @id @default(cuid())

  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notificationId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  /// Set by beacon/CLI GET on first impression
  firstSeenAt DateTime @default(now())

  /// Times shown (incremented per beacon/CLI view)
  showCount Int @default(1)

  /// User dismissed in webapp
  webappDismissedAt DateTime?

  /// User clicked a link in webapp
  webappClickedAt DateTime?

  /// Auto-dismissed or expired in CLI
  cliDismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, userId])
}

enum ErrorGroupStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

/**
 * Error group state is used to track when a user has interacted with an error (ignored/resolved)
 * The actual error data is in ClickHouse.
 */
model ErrorGroupState {
  id String @id @default(cuid())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId String

  /**
   * You can ignore/resolve an error across all environments, or specific ones
   */
  environment   RuntimeEnvironment? @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environmentId String?

  taskIdentifier   String
  errorFingerprint String

  status ErrorGroupStatus @default(UNRESOLVED)

  /**
   * Error is ignored until this date
   */
  ignoredUntil                 DateTime?
  /**
   * Error is ignored until this occurrence rate
   */
  ignoredUntilOccurrenceRate   Int?
  /**
   * Error is ignored until this total occurrences
   */
  ignoredUntilTotalOccurrences Int?

  /// Total occurrence count at the time the error was ignored (from ClickHouse).
  /// Used with ignoredUntilTotalOccurrences to compute occurrences since ignoring.
  ignoredAtOccurrenceCount BigInt?

  /**
   * Error was ignored at this date
   */
  ignoredAt       DateTime?
  /**
   * Reason for ignoring the error
   */
  ignoredReason   String?
  /**
   * User who ignored the error
   */
  ignoredByUserId String?

  /**
   * Error was resolved at this date
   */
  resolvedAt        DateTime?
  /**
   * Error was resolved in this version
   */
  resolvedInVersion String?
  /**
   * User who resolved the error
   */
  resolvedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([environmentId, taskIdentifier, errorFingerprint])
  @@index([environmentId, status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PLATOS AGENT MODELS
//
// Scoping model: every row below is keyed by trigger.dev's native hierarchy —
// (organizationId, projectId, environmentId) — so agents, threads, profiles,
// entities, and tool mappings are isolated per project and per environment.
// Environments use RuntimeEnvironment.id (DEVELOPMENT | STAGING | PREVIEW |
// PRODUCTION). An agent slug is unique per (projectId, environmentId); same
// slug in dev and prod are separate rows.
//
// Entities (renamed from PlatosConnectedOrg) live at project level — one
// project can register many entities (e.g. fandesk-main, fandesk-billing).
// Tool mappings are env-scoped so the same entity can wire different
// callback URLs for dev vs prod.
// ═══════════════════════════════════════════════════════════════════════════════

/// An AI agent definition. Configures model, tools, memory, and system prompt.
/// Scoped to (organizationId, projectId, environmentId).
model PlatosAgent {
  id String @id @default(cuid())

  // Scope
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Identity
  name                String
  slug                String // unique per (projectId, environmentId)
  model               String // e.g., "anthropic:claude-sonnet-4-20250514"
  systemPrompt        String? @db.Text
  promptBlocks        Json? // Array<{ id, type, name, content, enabled, editable, order }> — default + custom STATIC blocks
  dynamicBlocks       Json? // Array<{ key, name, defaultContent, description }> — declared DYNAMIC block templates (runtime injection via payload)
  maxSteps            Int     @default(20)
  contextLimit        Int     @default(20) // How many prior messages to load (L1 context window)
  historyMode         String  @default("rolling") // "rolling" | "compact"
  compactThreshold    Int     @default(40) // Thread length at which compaction triggers (if historyMode=compact)
  // Refactor: control-plane + trigger substrate. "direct" = today's in-process
  // streaming turn (low latency); "durable" = turn runs as a trigger Session/task
  // (resumable/suspendable, for AI-employees). See docs/refactor/platos-trigger-refactor.md.
  executionMode       String  @default("direct") // "direct" | "durable"
  enableUserProfiling Boolean @default(false) // If true, maintain per-user profile + inject snippet into every conversation
  toolMode            String  @default("direct") // LEGACY — superseded by toolsBlockConfig.mode. Kept for backwards compat.
  toolsBlockConfig    Json? // { mode: "direct"|"sub-agent"|"execute-tool", enabledTools: string[], perToolPerms: Record<toolName, { requiresApproval, destructive }> }
  subAgentConfig      Json? // { model, maxSteps, systemPrompt } — only used when toolsBlockConfig.mode === "sub-agent"
  memoryConfig        Json? // { conversation: true, working: true, semantic: { enabled }, graph: { enabled } }
  metaTools           Json? // { find_tools: true, execute_tools: true, remember: true, recall: true }
  isActive            Boolean @default(true)

  // Theme G — Agent lifecycle (versioning, rollback, canary, feature flags).
  //
  // `currentVersionId` points to the PlatosAgentVersion snapshot representing the
  // agent's current published config. Every save creates a new PlatosAgentVersion
  // and bumps this pointer. Rollback simply flips this pointer to an older version.
  //
  // `canaryVersionId` + `canaryPercent` enable percent-based A/B traffic splitting.
  // On a new thread's first message, the runtime picks `canary` vs `current` based
  // on a hash of threadId + `canaryPercent`, records the decision in
  // `PlatosAgentThread.lockedVersionId`, and never flips mid-thread.
  //
  // `featureFlags` gates experimental meta-tools / behaviors per agent — a simple
  // { [flagKey]: boolean } map read by the runtime at message time.
  currentVersionId String?
  canaryVersionId  String?
  canaryPercent    Int     @default(0)
  featureFlags     Json?

  // Theme F.5 — agent-level default output schema. JSON Schema (draft-07-ish)
  // describing the shape the LLM must return on every turn. When set, the
  // runtime calls `generateObject` / `streamObject` instead of `streamText`,
  // validates the model output against the schema, and retries once with
  // the validation errors fed back as a correction prompt on failure.
  // Per-turn `PlatosAgentMessage.outputSchema` takes precedence over this
  // agent-level default — request > agent.
  outputSchema Json?

  /// Theme O.2 — per-agent memory-extraction policy.
  /// Shape:
  ///   {
  ///     enabled: boolean,
  ///     kinds: string[]           // subset of fact|preference|event|relationship
  ///     confidenceThreshold: number  // 0..1, drop below
  ///     maxPerSession: number        // cap extractions per thread pass
  ///     minMessagesBeforeRun: number // require N new messages before run
  ///   }
  /// Null = treat as enabled with documented defaults (all kinds, 0.6, 10, 6).
  extractionPolicy Json?

  /// PIFSP-18 — per-agent PII governance configuration.
  /// Controls regex-based detection + blocking/redacting/warning on
  /// PII patterns (Aadhaar, PAN, credit cards, phone, email, etc.).
  /// Null = all PII filters OFF (opt-in per agent, not a platform default).
  /// Shape: { pii?: { enabled, filters: [{kind, mode, applyTo, customRegex?, redactReplacement?}], secondaryLlmValidation? } }
  governanceConfig Json?

  /// Theme K.15 — per-agent tier-3 MCP permission overrides.
  /// Map of tool-name (exact or glob `linear.*`) → permission state
  /// ("auto_allow" | "require_approval" | "block"). Effective policy
  /// at invocation time = MOST_RESTRICTIVE(platform, org, agent, user-session)
  /// so a tier-3 entry can only TIGHTEN, never loosen. Null = no
  /// overrides (tiers 1/2/4 decide alone).
  mcpPermissions Json?

  /// Theme CTX.1 — per-agent session-context mapping.
  /// Declares WHICH keys in `PlatosAgentThread.sessionContext` play WHICH role
  /// at runtime (CTX.2 wires the behavior). Shape:
  ///   {
  ///     promptVars: string[],                                       // keys substituted into prompt templates
  ///     toolArgInjection: Record<toolName, Record<argName, key>>,  // auto-inject ctx values into tool args
  ///     envelopeKeys: string[],                                    // keys forwarded in the __platos envelope
  ///     entityIdsKey: string                                       // key whose value (string[]) routes the tool matrix
  ///   }
  /// Null = default behavior: no auto-injection, no matrix routing, all in-scope tools visible.
  contextMapping Json?

  /// EOBD.89 — visibility gates who can start a thread with this agent:
  ///   "private"      — requires a session token with a concrete userId
  ///                    (default — matches v1 behaviour).
  ///   "public-guest" — the agent can be chatted with by anonymous
  ///                    visitors. The webapp mints a scope-only guest
  ///                    session token with a random guestId; downstream
  ///                    rate limits are enforced per session + per IP.
  ///
  /// Kept as a plain String (not an enum) so future modes (e.g.
  /// `public-authed-oauth`) don't require a migration.
  visibility String @default("private")

  /// PIFSP-14 — optional FK to a PlatosProviderKey row. When set, the
  /// runtime uses that specific key instead of the scope-default key for
  /// the agent's model provider. Null = use scope default (backwards compat).
  providerKeyId String?

  /// Per-request model routing — array of named model routes.
  /// Shape: Array<{ label: string, model: string, providerKeyId: string|null, isDefault: boolean }>
  /// When present the runtime picks the route matching the per-request `modelLabel`
  /// (falling back to the isDefault route, then routes[0]). When null/empty the
  /// legacy `model` + `providerKeyId` fields are used directly for full backwards compat.
  /// Labels are operator-defined: "alpha", "bravo", "fast", "smart", "cheap", etc.
  modelRoutes Json?

  /// LAUNCH-2 — declarative retry / fallback waterfall, applied to every
  /// model invocation via `retry-fetch.ts`. Shape:
  /// { rules: Array<{
  ///     trigger: "rate-limit" | "temporary-error" | "auth-error" | "network-error",
  ///     action: "fail" | "retry" | "fallback",
  ///     retryCount?: number, backoffMs?: number, backoffMultiplier?: number,
  ///     waitForRetryAfter?: boolean, fallbackToRouteLabel?: string,
  ///   }> }
  /// Null = use built-in DEFAULT_RETRY_RULES (sensible defaults: retry 2x on
  /// 429/5xx, fail-fast on 401/403, retry once on network error).
  agentRetryConfig Json?

  /// PRA-TC: Slack-style threading. When false (default), no thread UI shown.
  /// threadingConfig shape: { maxDepth: 1, showReplyCount: true, defaultThreadOpen: false }
  enableThreading Boolean @default(false)
  threadingConfig Json?

  /// PRA-AC: optional cluster membership. NULL = standalone agent.
  clusteringId String?
  clustering   PlatosAgentCluster? @relation(fields: [clusteringId], references: [id], onDelete: SetNull)

  threads          PlatosAgentThread[]
  versions         PlatosAgentVersion[]    @relation("PlatosAgentVersions")
  skills           PlatosAgentSkill[]
  postmanTemplates PlatosPostmanTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, environmentId, slug])
  @@index([organizationId, projectId, environmentId])
  @@index([projectId, environmentId])
  @@index([clusteringId])
}

/// PRA-AC: Groups agents into a shared-context envelope.
/// Agents in the same cluster share user memory and thread visibility.
/// Each agent retains its own model, system prompt, tools, and version lock.
model PlatosAgentCluster {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String? @db.Text

  /// { primaryAgentId: string, roles: { [agentId]: "chat" | "bgo" | "specialist" } }
  metadata Json?

  agents  PlatosAgent[]
  threads PlatosAgentThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, environmentId, slug])
  @@index([organizationId, projectId, environmentId])
}

/// Theme G — Immutable snapshot of a PlatosAgent config, one row per save.
///
/// `snapshot` captures the full user-editable config (model, systemPrompt,
/// promptBlocks, dynamicBlocks, toolsBlockConfig, subAgentConfig, memoryConfig,
/// metaTools, maxSteps, contextLimit, historyMode, compactThreshold,
/// enableUserProfiling, enableThreading, threadingConfig). It is never mutated after creation — rollback creates
/// a new version pointing at the older snapshot rather than editing history.
///
/// `versionNumber` auto-increments per-agent starting at 1. The diff UI sorts
/// by versionNumber descending; rollback flips `PlatosAgent.currentVersionId`.
model PlatosAgentVersion {
  id            String      @id @default(cuid())
  agentId       String
  agent         PlatosAgent @relation("PlatosAgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  versionNumber Int
  createdBy     String // userId that saved this revision
  note          String?     @db.Text
  snapshot      Json // full config serialised at save time
  createdAt     DateTime    @default(now())

  @@unique([agentId, versionNumber])
  @@index([agentId])
}

/// Registered end-user of the Platos platform. One row per unique external
/// user identity within a (org, project, env) scope. Lazily created on first
/// thread creation — the row does not need to pre-exist. `externalUserId` is
/// the opaque ID supplied by the entity backend via `X-Platos-User-Id`.
model PlatosEndUser {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Opaque user id forwarded by the entity backend (scope.userId).
  externalUserId String

  /// Display metadata extracted from sessionContext on first contact.
  displayName String?
  email       String?

  /// Arbitrary caller-supplied metadata (channel prefs, tags, etc.).
  metadata Json?

  /// Incremented on each thread create; cached to avoid JOIN on list views.
  threadCount  Int      @default(0)
  lastActiveAt DateTime @default(now())

  threads    PlatosAgentThread[]
  memories   PlatosMemory[]
  toolAudits PlatosToolCallAudit[]
  identities PlatosEndUserIdentity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, environmentId, externalUserId], map: "platos_end_user_scope_ext_uniq")
  @@index([organizationId, projectId, environmentId, lastActiveAt(sort: Desc)], map: "platos_end_user_scope_last_active_idx")
}

/// A channel-native identity claim linked to a PlatosEndUser (link-not-merge).
/// Each row asserts "this person is reachable/known as `handle` on `channel`",
/// optionally `verified` and attributed to the connected entity that asserted
/// it (`sourceEntityId`). Multiple identities fan into one canonical person;
/// a (channel, handle) is unique per scope and never re-pointed once claimed.
model PlatosEndUserIdentity {
  id             String @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String

  platosEndUserId String
  platosEndUser   PlatosEndUser @relation(fields: [platosEndUserId], references: [id], onDelete: Cascade)

  /// Channel slug: "email" | "phone" | "slack" | "teams" | "whatsapp" | "telegram" | "discord" | "web" | ...
  channel String
  /// Channel-native id: email addr, E.164 phone, Slack user id, ...
  handle String

  /// Whether the asserting entity vouched for this identity (trust gate).
  verified Boolean @default(false)
  /// Which connected entity asserted this identity (trust anchor).
  sourceEntityId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, environmentId, channel, handle])
  @@index([platosEndUserId])
}

/// Platos API key + allowed origins per scope. When a key exists for a scope,
/// all agent requests must carry X-Platos-Api-Key matching the stored hash.
/// If allowedOrigins is non-empty, the request Origin header must also match.
model PlatosAccessKey {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prefix shown in the UI (first 16 chars of the raw key). e.g. "platos_live_abc1"
  keyPrefix      String
  /// SHA-256 hex of the raw key. Never store the raw key.
  keyHash        String
  /// CORS origin allowlist. Empty = no origin restriction.
  allowedOrigins String[] @default([])

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([organizationId, projectId, environmentId], map: "platos_access_key_scope_uniq")
  @@index([organizationId, projectId, environmentId], map: "platos_access_key_scope_idx")
}

/// Saved Postman test configuration per agent. Stores the userId to simulate
/// and the sessionContext JSON so operators don't retype it every session.
model PlatosPostmanTemplate {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  agentId String
  agent   PlatosAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name           String /// e.g. "Tejas – Winsen G0 Prod"
  simulateUserId String
  sessionContext Json?

  createdBy String /// operator userId who saved this
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId, environmentId, agentId], map: "platos_postman_tmpl_scope_agent_idx")
}

/// A conversation thread between a user and an agent.
/// Inherits scope from its agent (denormalized for indexed filtering).
model PlatosAgentThread {
  id      String      @id @default(cuid())
  agentId String
  agent   PlatosAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Scope (denormalized from agent)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId                 String
  /// LAUNCH-12 — the actual logged-in operator who initiated this thread.
  /// In Postman mode `userId` is overridden to the simulated user (when the
  /// caller is an org admin); `createdByUserId` always stays as the real
  /// session user so the operator can still see their own threads.
  /// Nullable for backwards compat with rows created before this column;
  /// new rows always populate it.
  createdByUserId        String?
  platosEndUserId        String?
  platosEndUser          PlatosEndUser? @relation(fields: [platosEndUserId], references: [id], onDelete: SetNull)
  title                  String?
  status                 String         @default("active") // active, completed, archived
  compactedSummary       String?        @db.Text // Rolling summary of messages older than contextLimit
  /// PIFSP-17 — compaction observability + mutex.
  compactedAt            DateTime? // When the last successful compaction ran
  compactedUpToMessageId String? // Last message included in compactedSummary
  compactionInFlight     Boolean        @default(false) // Optimistic mutex; prevents duplicate compaction jobs
  turnCount              Int            @default(0)

  // Theme G — per-thread version lock. On the thread's first message, the
  // runtime decides whether the thread is served by the agent's current or
  // canary version (hash-bucketed by canaryPercent) and writes that id here.
  // Every subsequent turn reads the snapshot referenced by this column so the
  // model, prompt, and tools never flip mid-thread even if someone rolls back
  // or tweaks canaryPercent while the conversation is live.
  lockedVersionId String?

  // Theme CTX.1 — arbitrary key=value session context set by the playground /
  // consumer SDK / internal callers. Shared across every turn in the thread.
  // Used by CTX.2 for prompt substitution, tool-arg auto-injection, and
  // tool-matrix routing via `entity_ids: string[]`. Null = no context set.
  sessionContext Json?

  // Theme F — thread metadata surface. Tags are a simple user-assignable
  // string[]; pinnedAt / archivedAt mirror common inbox-style UX affordances.
  // The three of them power the filter bar on the conversations list.
  tags       String[]  @default([])
  pinnedAt   DateTime?
  archivedAt DateTime?

  // Theme F — fork lineage. When a user forks a thread at message N, the new
  // thread points back at the parent thread here, and records the message id
  // the fork diverged at. History through `forkedFromMessageId` is cloned
  // (preserved as independent rows) so the new thread is self-contained.
  parentThreadId      String?
  parentThread        PlatosAgentThread?  @relation("PlatosAgentThreadForks", fields: [parentThreadId], references: [id], onDelete: SetNull)
  forks               PlatosAgentThread[] @relation("PlatosAgentThreadForks")
  forkedFromMessageId String?

  /// PRA-AC: denormalized cluster FK for fast cross-agent thread queries.
  /// Set when the creating agent is a cluster member.
  clusteringId String?
  clustering   PlatosAgentCluster? @relation(fields: [clusteringId], references: [id], onDelete: SetNull)

  messages  PlatosAgentMessage[]
  artifacts PlatosAgentArtifact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId, environmentId, userId])
  @@index([agentId])
  @@index([parentThreadId])
  @@index([clusteringId, userId])
}

/// A single message in a conversation thread.
model PlatosAgentMessage {
  id              String            @id @default(cuid())
  threadId        String
  thread          PlatosAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role            String // "user" | "assistant" | "tool"
  content         String?           @db.Text
  toolCalls       Json? // [{name, params, result, actionId, callId}]
  thinkingContent String?           @db.Text
  responseJson    Json? // {usage, model, latency, cost_cents}

  /// Theme H.4 — key version used to encrypt `content` / `thinkingContent`.
  /// `null` / `0` means plaintext (legacy rows + fresh deploys with no key
  /// configured). `1+` maps to PLATOS_MESSAGE_ENCRYPTION_KEY / per-version
  /// keys rotated via PLATOS_MESSAGE_ENCRYPTION_KEY_V<N>. When set, the
  /// content columns hold base64(iv + authTag + ciphertext) and the
  /// ConversationService transparently decrypts on read.
  encKeyVersion Int?

  // Theme F — per-turn conversation controls. `systemPromptOverride` takes
  // precedence over the agent's systemPrompt for the single turn it is set on
  // (never mutates the stored agent config). `outputSchema` captures either a
  // JSON schema or a Zod-serialised form for structured output on a specific
  // turn — when present, the runtime calls generateObject and retries once
  // on parse/validation failure before surfacing the error.
  systemPromptOverride String? @db.Text
  outputSchema         Json?

  // Theme F — edit + rerun lineage. `status` is "active" for the current
  // canonical message and "edited_out" for historical copies soft-deleted
  // by edit-and-rerun. `editParentMessageId` + `revision` form a linear chain
  // (revision starts at 1, each edit increments) so the UI can show prior
  // edits without losing history.
  status              String               @default("active") // "active" | "edited_out"
  editParentMessageId String?
  editParentMessage   PlatosAgentMessage?  @relation("PlatosAgentMessageRevisions", fields: [editParentMessageId], references: [id], onDelete: SetNull)
  revisions           PlatosAgentMessage[] @relation("PlatosAgentMessageRevisions")
  revision            Int                  @default(1)

  /// PRA-TC: thread reply parent. NULL = main conversation timeline.
  /// Non-null = reply in a sub-thread. Depth enforced at app layer (max 1).
  threadReplyToId String?
  threadReplyTo   PlatosAgentMessage?  @relation("MessageThreadReplies", fields: [threadReplyToId], references: [id], onDelete: SetNull)
  threadReplies   PlatosAgentMessage[] @relation("MessageThreadReplies")

  /// PRA-TC: cached reply count — atomically incremented on each new reply.
  replyCount Int @default(0)

  /// PRA-AC: which agent in a cluster wrote this message. NULL = single-agent or legacy.
  /// Plain string (no FK) so attribution survives an agent being removed from a cluster.
  authorAgentId String?

  attachments PlatosMessageAttachment[]

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([threadId, status])
  @@index([editParentMessageId])
  @@index([threadId, threadReplyToId])
}

/// Theme F — Platos-generated artifact produced by an agent (markdown, code,
/// HTML, JSON, CSV, SVG, image). Every artifact lives inside a conversation
/// thread and tracks linear revisions — `revision` starts at 1 and monotonically
/// increments per (threadId, artifactKey). The artifactKey is a stable handle
/// the agent uses to target a specific artifact for revise_artifact; the id is
/// per-row, the key groups revisions.
///
/// Scope fields mirror the thread's scope (denormalized for indexed filtering
/// like the rest of the Platos V2 surface) so cross-scope isolation holds.
///
/// `kind` is validated against a canonical allowlist (see PLATOS_SPEC §10 #7):
///   markdown | code | html | json | csv | svg | image
/// Unknown kinds are rejected at the write boundary — never inserted.
model PlatosAgentArtifact {
  id String @id @default(cuid())

  // Scope (Theme A invariant — every scoped row carries all four axes).
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  threadId String
  thread   PlatosAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Stable grouping key per thread. Generated on first `generate_artifact`
  // call; every `revise_artifact` on the same key writes a new row with the
  // same `artifactKey` and `revision = prior + 1`. Queries for "current
  // artifact" select the max revision for each (threadId, artifactKey).
  artifactKey String
  revision    Int    @default(1)

  // Canonical kind — enforced by service layer against the allowlist.
  kind String // "markdown" | "code" | "html" | "json" | "csv" | "svg" | "image"

  // Optional human title from the agent ("Sales Q1 summary", etc.)
  title    String?
  // Language tag for code artifacts (e.g. "typescript", "python"). Ignored
  // for non-code kinds. Not a union type on DB — kept as free-form string
  // so new Prism grammars don't require a migration.
  language String?
  // Raw content as produced by the agent. For `image`, this stores either a
  // `platos-attachment://<attachmentId>` ref or a data URL; renderers branch
  // on the scheme. Never large binary — images live in MinIO.
  content  String  @db.Text

  // Rich metadata hook — rendering hints, source tool call id, etc.
  metadata Json?

  // Which assistant message produced this artifact revision. Nullable so
  // test fixtures + back-fills work without synthesising a message id.
  producedByMessageId String?

  createdBy String // userId or "agent:<agentId>"
  createdAt DateTime @default(now())

  @@unique([threadId, artifactKey, revision])
  @@index([organizationId, projectId, environmentId])
  @@index([threadId, artifactKey])
  @@index([threadId, createdAt])
}

/// Theme D — multimodal attachments stored in MinIO (S3-compatible).
///
/// Rows are created when the browser requests a presigned PUT URL. At that
/// point the message has not yet been sent, so `messageId` is null and the
/// row is considered "transient" until the user sends the message carrying
/// this attachmentId. The retention task deletes transient rows after
/// PLATOS_ATTACHMENT_GRACE_DAYS (default 7 days); attached rows after
/// PLATOS_ATTACHMENT_TTL_DAYS (default 30 days).
///
/// Scope fields (organizationId, projectId, environmentId) enforce
/// cross-scope isolation on GET — a user in another org can never fetch
/// another org's attachment even if they guess the id.
model PlatosMessageAttachment {
  id String @id @default(cuid())

  // Scope (Theme A invariant — every scoped row carries all four axes).
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Null until attached to a sent message. Retention task uses this to
  // distinguish unattached uploads (7-day grace) from attached ones (30-day TTL).
  messageId String?
  message   PlatosAgentMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  // Who uploaded this — userId from the scope at upload time.
  uploadedBy String

  // "image" | "audio" | "video" | "document" — routed differently by the
  // agent runtime's multimodal adapter. "document" is the fallback for
  // unknown mime types.
  kind     String
  mimeType String

  // Byte size reported by the client; validated against
  // PLATOS_ATTACHMENT_MAX_BYTES on upload and summed per-org for quota checks.
  bytes Int

  // Optional media metadata, populated by the client before upload.
  width       Int?
  height      Int?
  durationSec Int?

  // MinIO object key. Namespaced by scope so listing + cleanup is scoped
  // naturally. Pattern: `{organizationId}/{projectId}/{environmentId}/{id}/{originalName}`.
  storageKey   String
  originalName String?

  // Short SHA-256 hash of the uploaded bytes (set by client or recomputed
  // during retention audits). Helps dedup + trace.
  contentHash String?

  createdAt DateTime  @default(now())
  // Set by the retention task:
  //   - PLATOS_ATTACHMENT_GRACE_DAYS from createdAt if messageId is null
  //   - PLATOS_ATTACHMENT_TTL_DAYS from createdAt once attached
  // Rows past expiresAt are hard-deleted by the daily scheduled task (D.8).
  expiresAt DateTime?

  @@index([organizationId, projectId, environmentId])
  @@index([messageId])
  @@index([uploadedBy])
  @@index([expiresAt])
}

/// A connected external backend that syncs tools to Platos via the platools WS
/// protocol. Previously named PlatosConnectedOrg — renamed to "Entity" to avoid
/// collision with trigger.dev's internal Organization concept.
///
/// Entities live at PROJECT level. One project can register many entities —
/// e.g. "fandesk-main", "fandesk-billing", "hr-system". Tool mappings below
/// are further env-scoped so the same entity can wire different callback URLs
/// for dev vs prod.
model PlatosConnectedEntity {
  id String @id @default(cuid())

  // Scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Identity
  entityId            String // human-readable slug e.g. "fandesk-main"
  displayName         String
  mcpUrls             String[] // MCP endpoints to sync tools from
  serviceSecret       String // encrypted, for HMAC + WS upgrade auth
  // PIFSP-3: `customParams Json?` column dropped (migration
  // 20260424010000_platos_entity_drop_custom_params). Superseded by
  // per-agent "MCP arguments" which belong on the agent editor, not the
  // entity record. Runtime readers + UI were removed in the same release.
  connectionStatus    String    @default("disconnected") // connected, disconnected
  lastConnectedAt     DateTime?
  disconnectAlertSent Boolean   @default(false)

  // Per-entity agent allow-list. Empty `[]` = unrestricted (every agent
  // in the scope sees this entity's tools — back-compat default). When
  // non-empty, only the listed PlatosAgent.id values can see the tools
  // from this entity via the scoped matrix / find_tools / tool-mappings.
  // Managed-agent deployments use this to give each agent its own tool
  // surface even when 300 entities live in the same scope.
  linkedAgentIds String[] @default([])

  // Browser origins this entity is allowed to be embedded from. Each
  // value is matched verbatim against the request's `Origin` header
  // (e.g. `https://acme.com`, `http://localhost:3000`). The agent's
  // global CORS handler unions every entity's allowedOrigins with the
  // operator-trusted PLATOS_CORS_ORIGIN list. Empty = entity is
  // backend-only; chat widgets / browser embeds will be rejected by the
  // browser CORS preflight even if the session token is valid.
  allowedOrigins String[] @default([])

  // The Connect reimagining: an entity is a *doorway*, and `capabilities`
  // declares which kinds of doorway it is.
  //   "tools"    (default) — classic platools/MCP tool sync
  //   "channel"  — a messaging-channel doorway (see PlatosChannelConnection)
  //   "identity" — an identity / auth provider
  // An entity may carry more than one capability.
  capabilities String[] @default(["tools"]) // "tools" | "channel" | "identity"

  // Transport discriminator — *how* this entity's tools are moved.
  //   "wire" (default, all existing entities) — inbound platools handshake:
  //     the customer backend connects to Platos (WS /tools/sync or an HTTP
  //     callback) and Platos signs each dispatch with `serviceSecret` (HMAC).
  //   "mcp" — outbound MCP client: Platos initiates the connection *to* an
  //     external MCP server via the MCP SDK, authenticating with headers.
  //     No serviceSecret handshake, no callback URL; Platos is the client.
  //     Transport config lives on the 1:1 `mcpClient` (PlatosEntityMcpClient).
  // Orthogonal to `capabilities` — an mcp entity is capabilities:["tools"],
  // connectionKind:"mcp". `capabilities` = which doorway; connectionKind =
  // which transport moves the tool call.
  connectionKind String @default("wire") // "wire" | "mcp"

  // PIFSP-3 (Deliverable 9) — encrypted test credentials used only when a
  // dev clicks "Test" on a tool from the dashboard. Shape (after decrypt):
  //   { headers: [{name, value}, ...], userId?, updatedAt, updatedByUserId }
  // Never used in production tool dispatch — production uses HMAC signed
  // with `serviceSecret`. Encrypted via MessageCryptoService envelope
  // (TEXT rather than JSONB because the envelope is an opaque base64 blob).
  testCredentials String? @db.Text

  toolMappings PlatosEntityToolMapping[]
  /// Channel doorways (Slack / Telegram / WhatsApp / Discord) bound through
  /// this entity. The FK on PlatosChannelConnection is optional
  /// (onDelete: SetNull) so a channel can outlive the entity that spawned it.
  channelConnections PlatosChannelConnection[]
  /// PIFSP-21 — per-entity MCP gateway configuration (1:1 optional).
  /// When null, `/mcp/entity/:entityId` returns 404 and tokens cannot be
  /// issued for this entity. When present with `enabled = false`, the
  /// MCP endpoint is registered but every request returns 403 so the
  /// dashboard can flip the flag without re-running migrations.
  mcpConfig    PlatosEntityMcpConfig?
  /// MCP consumption (opposite direction to `mcpConfig`) — outbound MCP client
  /// transport config (1:1 optional). Present iff `connectionKind == "mcp"`.
  /// Do NOT confuse with `mcpConfig`: that is Platos *serving* MCP to external
  /// clients; this is Platos *consuming* an external MCP server.
  mcpClient    PlatosEntityMcpClient?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, entityId])
  @@index([organizationId, projectId])
}

/// A messaging-channel doorway bound to ONE agent. Where PlatosConnectedEntity
/// is the classic tool-sync doorway, a channel connection is the inbound side
/// of the Connect reimagining: a Slack workspace / Telegram bot / WhatsApp
/// number / Discord app whose native conversations route to a single Platos
/// agent (v1: one agent per connection).
///
/// `credentials` is an ENCRYPTED envelope (same MessageCryptoService envelope
/// pattern as PlatosConnectedEntity.testCredentials — an opaque base64 blob,
/// which is why it is stored as TEXT rather than JSONB).
///
/// `webhookSecret` is 32 random bytes (hex) minted at create time; the inbound
/// webhook URL carries `/channels/:id/:webhookSecret` as a first auth factor
/// alongside the provider's own signature verification. The inbound RUNTIME
/// (receiving posts) is a separate slice — this model is management-only.
model PlatosChannelConnection {
  id             String @id @default(cuid())

  // Scope (Theme A invariant — scalar axes only, matching PlatosEndUserIdentity).
  organizationId String
  projectId      String
  environmentId  String

  // The entity this channel was spawned through. Optional: onDelete SetNull so
  // the channel can outlive its entity.
  entityPk String?
  entity   PlatosConnectedEntity? @relation(fields: [entityPk], references: [id], onDelete: SetNull)

  provider    String // "slack" | "telegram" | "whatsapp" | "discord"
  displayName String?

  // The DEFAULT agent this channel routes to when no routing rule matches.
  agentId String

  // RUNTIME (one connection → many agents, v1) — an ordered rule list that
  // overrides the default `agentId` on a per-message basis. Null / empty =>
  // every message uses `agentId`. Shape (each element):
  //   { "match": { "type": "channel", "id": "C123ABC" }, "agentId": "..." }
  //     — matches when the inbound platform channel/group/guild-channel id
  //       equals `id`.
  //   { "match": { "type": "prefix", "value": "ada" }, "agentId": "..." }
  //     — matches when the message text starts with "ada:" or "@ada"
  //       (case-insensitive).
  // Resolution: first matching rule wins, else `agentId`. Each rule's
  // `agentId` is validated in-scope at WRITE time (management slice); the
  // resolved agent is PINNED onto PlatosChannelThread.agentId on first
  // contact so a conversation never switches agents mid-thread.
  agentRouting Json?

  enabled Boolean @default(true)

  // ENCRYPTED envelope (MessageCryptoService) — same pattern as entity
  // testCredentials. Opaque base64 blob → String maps to Postgres TEXT.
  credentials String?

  // Provider extras: slack team_id, whatsapp phoneNumberId, webhook verify
  // tokens, etc.
  config Json?

  // Random 32-byte hex minted at create; first auth factor on the inbound URL.
  webhookSecret String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads PlatosChannelThread[]

  @@index([organizationId, projectId, environmentId, provider])
  @@index([agentId])
}

/// Maps a channel-native conversation (a Slack channel/thread, a Telegram chat,
/// a WhatsApp conversation) to a Platos thread. One row per distinct
/// channel-native thread key per connection.
model PlatosChannelThread {
  id           String @id @default(cuid())
  connectionId String
  connection   PlatosChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Chat SDK thread id, e.g. "slack:C123ABC:1234567890.123456".
  channelThreadKey String
  platosThreadId   String
  platosEndUserId  String?

  // RUNTIME — the agent PINNED to this channel-native conversation on first
  // contact (resolved once via PlatosChannelConnection.agentRouting, then
  // frozen). Every later message in this channel-thread reuses this agent so
  // conversations never switch agents mid-thread. Null only for legacy rows
  // created before pinning existed (fall back to the connection default).
  agentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, channelThreadKey])
  @@index([platosThreadId])
  @@index([agentId])
}

/// Connect v3 (Phase A) — the PUBLISHABLE channel-app identity. Where
/// PlatosChannelConnection (v2, T-BYO) is a single customer-owned channel
/// bound to one agent, PlatosChannelApp is ONE platform-owned app (per
/// provider) installed into N external workspaces via OAuth V2 — the
/// marketplace / "Add to Slack" tier. The owner scope
/// (organizationId/projectId/environmentId) is the AGENT owner; each
/// PlatosChannelInstallation is a foreign workspace talking to that owner's
/// agent. `clientSecret` / `signingSecret` are ENCRYPTED envelopes
/// (MessageCryptoService, same pattern as PlatosChannelConnection.credentials).
model PlatosChannelApp {
  id String @id @default(cuid())

  // Scope = the agent OWNER (Theme A invariant — scalar axes only, matching
  // PlatosChannelConnection). Installations are external workspaces; they do
  // NOT carry scope of their own.
  organizationId String
  projectId      String
  environmentId  String

  provider    String // "slack" (v1)
  displayName String?

  // OAuth V2 app credentials. `clientId` is public; `clientSecret` and
  // `signingSecret` are ENCRYPTED envelopes (MessageCryptoService) — opaque
  // base64 blobs → String maps to Postgres TEXT. Never returned by the
  // management API (hasCredentials-style booleans only).
  clientId      String
  clientSecret  String // ENCRYPTED envelope
  signingSecret String // ENCRYPTED envelope

  // OAuth scopes requested at install time (joined into the authorize URL).
  scopes String[] @default([])

  // "private" (unlisted, direct install link only) | "public" (marketplace).
  distribution String @default("private")

  // Target Slack's first-class "Agents & AI Apps" surface (Phase B) rather
  // than a bare app_mention bot. Default on for new apps.
  aiAppsSurface Boolean @default(true)

  // Connect v3 (Phase D) — OAuth token rotation. Slack's
  // `token_rotation_enabled` is a ONE-WAY app-level setting (manifest
  // settings.token_rotation_enabled); when on, oauth.v2.access returns a
  // 12h `xoxe.` bot token + a single-use `xoxe-1-` refresh token +
  // expires_in=43200. This bool mirrors that app-level property so the
  // runtime knows to expect + refresh rotating tokens (the refresh LOGIC —
  // getFreshBotToken + the per-installation Redis lock — lives in
  // channel-runtime). Phase A already tolerates a refresh_token's absence,
  // so leaving this false is a zero-behavior-change default.
  tokenRotation Boolean @default(false)

  // Connect v3 (Phase C) — hosted account-linking policy:
  //   none     — no linking behavior (default; zero behavior change).
  //   optional — never blocks a turn; the connect URL is surfaced only when the
  //              user types "link"/"connect".
  //   required — an unlinked author's turn is WITHHELD until they complete Sign
  //              in with Slack (attaches a verified email identity to the same
  //              canonical person). Bindings are PlatosEndUserIdentity rows;
  //              the hosted flow's nonces live in Redis (no table here).
  linking String @default("none")

  // Fallback agent for a NEW installation when the install carries no binding
  // override. A per-install `agentId` (see PlatosChannelInstallation) wins.
  defaultAgentId String?

  // Ordered routing rules — SAME shape as PlatosChannelConnection.agentRouting
  // (first matching rule wins, else `defaultAgentId`). An installation's own
  // `agentRouting` overrides this per-install.
  agentRouting Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installations PlatosChannelInstallation[]

  @@index([organizationId, projectId, environmentId, provider])
}

/// Connect v3 (Phase A) — one row per external workspace that installed a
/// PlatosChannelApp. Keyed by (appId, teamId, enterpriseId): a classic
/// workspace install has teamId set + enterpriseId null; an Enterprise Grid
/// org-install has teamId null + enterpriseId set + isEnterpriseInstall true.
/// `botToken` / `refreshToken` are ENCRYPTED envelopes (MessageCryptoService).
/// Uninstall is SOFT (status=revoked) — app_uninstalled / tokens_revoked
/// arrive in an unguaranteed order, so handlers are idempotent and never
/// hard-delete.
model PlatosChannelInstallation {
  id    String           @id @default(cuid())
  appId String
  app   PlatosChannelApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  // Workspace identity. `teamId` is null on an Enterprise Grid org-install
  // (keyed by `enterpriseId` instead); both feed the (appId, teamId,
  // enterpriseId) unique key.
  teamId              String?
  enterpriseId        String?
  isEnterpriseInstall Boolean @default(false)
  teamName            String?

  // ENCRYPTED envelopes (MessageCryptoService). `refreshToken` +
  // `tokenExpiresAt` are populated only under token rotation (Phase D).
  botToken       String // ENCRYPTED envelope
  refreshToken   String? // ENCRYPTED envelope (token rotation, Phase D)
  tokenExpiresAt DateTime?

  botUserId     String?
  grantedScopes String[] @default([])

  // Per-install binding override. Null => fall back to app.defaultAgentId.
  agentId      String?
  // Per-install routing override. Null => fall back to app.agentRouting.
  agentRouting Json?

  installedByUserId String?

  // "active" | "revoked". SOFT lifecycle — see model doc comment.
  status    String    @default("active")
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads PlatosChannelAppThread[]

  @@unique([appId, teamId, enterpriseId])
  @@index([appId, status])
}

/// Connect v3 (Phase A) — maps a channel-native conversation inside an
/// INSTALLED workspace to a Platos thread. The app-tier analogue of
/// PlatosChannelThread; (installationId, channelThreadKey) is unique. FK to
/// PlatosChannelInstallation cascades on delete.
model PlatosChannelAppThread {
  id             String                    @id @default(cuid())
  installationId String
  installation   PlatosChannelInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  // Chat SDK thread id, e.g. "slack:C123ABC:1234567890.123456".
  channelThreadKey String
  platosThreadId   String
  platosEndUserId  String?

  // Agent PINNED to this conversation on first contact (resolved once via the
  // installation/app routing, then frozen so a conversation never switches
  // agents mid-thread). Mirrors PlatosChannelThread.agentId.
  agentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([installationId, channelThreadKey])
  @@index([platosThreadId])
}

/// PIFSP-21 — per-entity MCP gateway configuration. One row per
/// PlatosConnectedEntity.id (1:1, optional). Every Platos customer-facing
/// MCP endpoint pulls its toggle / identity mode / tool allow-list /
/// branding from this row.
///
/// `identityMode` + `identityProviders` land fully in PIFSP-22 (MVP in
/// this ticket is the bearer-token path).
/// `branding` lands in PIFSP-24 (rendered on the consent screen).
/// `toolAllowlist` is authoritative per PIFSP-25 — an empty array means
/// ZERO tools are exposed (explicit opt-in), never "all".
model PlatosEntityMcpConfig {
  entityPk             String                @id
  entity               PlatosConnectedEntity @relation(fields: [entityPk], references: [id], onDelete: Cascade)
  enabled              Boolean               @default(false)
  identityMode         String                @default("bearer") // "anonymous" | "oidc" | "bearer"
  identityProviders    Json? // OIDC provider config (PIFSP-22)
  bearerTokenCount     Int                   @default(0) // denormalized for dashboard
  branding             Json? // logo/color/name (PIFSP-24)
  toolAllowlist        String[]              @default([]) // empty = no tools exposed (PIFSP-25)
  consentCopy          String?               @db.Text
  redirectUriAllowlist String[]              @default([])
  rateLimitPerMinute   Int                   @default(60) // per mcpUser + entity
  /// MCPF-followup: per-entity opt-in for `_context` envelope injection
  /// into MCP-origin tool-call arguments. Default ON for new entities —
  /// the architectural contract is that Platos always injects `_context`
  /// and the SDK (platools-py / @platools/sdk) pops it before the handler
  /// runs. Existing rows that pre-date 2026-05-06 keep their previous
  /// value (false) so live legacy backends don't break; operators flip
  /// to true manually after upgrading the SDK and redeploying.
  /// CTX.2 envelopeKeys (agent contextMapping) is unaffected — that
  /// path is already opt-in via the agent config.
  injectMcpContext     Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([enabled])
}

/// MCP consumption (Surface 2) — outbound MCP client transport for a
/// `connectionKind == "mcp"` entity (1:1, PK = entityPk). This is the OPPOSITE
/// direction to `PlatosEntityMcpConfig`: that governs Platos *serving* MCP to
/// external clients (Claude Desktop etc.); this governs Platos *consuming* an
/// external MCP server (Composio, Linear-hosted, any streamable-HTTP MCP
/// endpoint). Do NOT merge the two or reuse identityProviders/toolAllowlist
/// across the boundary — two 1:1 configs, two directions, same entity.
///
/// These are the surviving transport fields of the deleted standalone MCP
/// server row, reparented onto the entity. slug/displayName/agentId/command/
/// args/envVars do NOT survive here — they map onto entity fields.
model PlatosEntityMcpClient {
  entityPk        String                @id
  entity          PlatosConnectedEntity @relation(fields: [entityPk], references: [id], onDelete: Cascade)
  transport       String // "remote-http" | "remote-sse" | "hosted-*" (stdio deferred, dev-only)
  url             String? // remote only; MAY contain {{endUserId}}
  credsSecretKey  String? // bare SecretStore var name; never the raw secret
  headersTemplate Json? // { header: valueTemplate }; values may embed {{secret}} / {{endUserId}}
  lastDiscoveryAt DateTime?
  discoveryError  String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

/// Central tool registry — one row per unique tool name. Shared across all
/// entities, projects, and orgs. BM25 tokens are computed once here.
model PlatosToolDefinition {
  id          String   @id @default(cuid())
  // SECURITY (audit H15) — tenant scope. `name` was globally @unique, so one
  // org registering a common tool name (`search`, `send_email`) overwrote the
  // shared row's description/paramSchema/bm25Tokens and re-indexed it, poisoning
  // another org's ranking + inheriting its schema. Scope the row per tenant.
  // Nullable for an additive migration: legacy rows (one per name, since name
  // was globally unique) become (NULL, NULL, name) — no constraint conflict —
  // and are backfilled/split before enforcing NOT NULL.
  organizationId String?
  projectId      String?
  name        String
  description String   @db.Text
  paramSchema Json // full JSON Schema for parameters
  category    String? // functional grouping: "calendar", "email", "tasks", etc.
  schemaHash  String // SHA-256 of paramSchema — detects schema changes across entities
  bm25Tokens  String[] // pre-tokenized for BM25 search (computed once, shared)

  entityMappings PlatosEntityToolMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, name])
  @@index([organizationId, projectId])
  @@index([category])
}

/// Entity-tool matrix — one row per tool per entity per environment. Same
/// entity can expose a tool with different callback URLs in dev vs prod.
/// Previously named PlatosOrgToolMapping.
model PlatosEntityToolMapping {
  id     String               @id @default(cuid())
  toolId String
  tool   PlatosToolDefinition @relation(fields: [toolId], references: [id], onDelete: Cascade)

  entityId String // FK → PlatosConnectedEntity.id (not the human-readable entityId slug)
  entity   PlatosConnectedEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  environmentId String
  environment   RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  enabled     Boolean @default(true)
  // Nullable: wire entities keep a callback URL; mcp-kind entities
  // (connectionKind == "mcp") have none — dispatch is outbound via the MCP
  // client and never reads this. The mcpDispatch branch fires before any
  // callback read, so a null is safe. In-memory `OrgToolEntry.callbackUrl`
  // stays typed `string` (coerced to the "mcp:noop" sentinel at hydration).
  callbackUrl String? // where to execute this tool for this entity in this env (null for mcp-kind)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([toolId, entityId, environmentId])
  @@index([entityId, environmentId, enabled])
}

/// Per-tool per-(entity, environment) health metrics. Updated on every tool call.
model PlatosToolHealth {
  id            String             @id @default(cuid())
  toolId        String
  entityId      String
  environmentId String
  environment   RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  lastCalledAt  DateTime?
  lastStatus    String? // "success" | "failed" | "timeout"
  failCount     Int       @default(0) // consecutive failures
  totalCalls    Int       @default(0)
  totalFailures Int       @default(0)
  p95LatencyMs  Int?
  avgLatencyMs  Int?

  updatedAt DateTime @updatedAt

  @@unique([toolId, entityId, environmentId])
  @@index([entityId, environmentId])
}

/// Per-tool-call audit record. One row per dispatched tool call. Scope-stamped
/// so the /monitoring/tool-audit endpoint can filter by (org, project, env) and
/// the replay action can re-dispatch with identical args via the same entity
/// routing. Intentionally denormalized: we carry toolName + entityId + agentId
/// + threadId at rest so the audit list can be rendered without cross-joins.
/// Theme E.5.
model PlatosToolCallAudit {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Stable tool identifier from the central PlatosToolDefinition registry.
  toolId   String?
  /// Human-readable tool name as invoked (the name the LLM emitted).
  toolName String

  /// Routing target at invocation time. We capture BOTH the human-readable
  /// slug (sourceEntityId) and the PlatosConnectedEntity PK so replay can
  /// re-route deterministically even if the slug is renamed later.
  entityId String? // slug
  entityPk String? // PlatosConnectedEntity.id

  agentId         String?
  threadId        String?
  /// The user who initiated the turn that produced this tool call.
  userId          String?
  /// FK to PlatosEndUser when known; null for legacy rows.
  platosEndUserId String?
  platosEndUser   PlatosEndUser? @relation(fields: [platosEndUserId], references: [id], onDelete: SetNull)
  /// OTel trace context at invocation time — useful for jumping from an
  /// audit row into the trace viewer.
  traceId         String?
  spanId          String?
  parentSpanId    String?

  /// Call inputs + outcome.
  args      Json
  result    Json?
  error     String? @db.Text
  status    String // "success" | "failed" | "timeout"
  latencyMs Int

  /// Cost in cents if the tool's handler reported one (e.g. LLM-backed tools).
  /// Most tool calls have no direct cost; keep nullable.
  costCents Float?

  /// PIFSP-21 — origin of the dispatch.
  ///   "agent_turn"     — normal LLM turn (default; null pre-migration rows
  ///                      implicitly mean this).
  ///   "skill_invocation" — from a skill block.
  ///   "replay"         — from the audit-replay endpoint.
  ///   "mcp_client"     — external MCP client via `/mcp/entity/:entityId`.
  ///   "wire_test"      — the entity-settings wire-test button.
  source      String?
  /// Populated only on `source = "mcp_client"` rows. The identity id
  /// carried by the OAuth access token — one per end-user of the
  /// customer's MCP integration (Claude Desktop user, Cursor user, …).
  mcpUserId   String?
  /// OAuth client id that made the call (the MCP client's DCR-assigned
  /// client_id). Populated only on `source = "mcp_client"`.
  mcpClientId String?

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId, createdAt(sort: Desc)], map: "platos_tool_audit_scope_createdAt_idx")
  @@index([organizationId, projectId, environmentId, threadId], map: "platos_tool_audit_scope_thread_idx")
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_tool_audit_scope_agent_idx")
  @@index([organizationId, projectId, environmentId, toolName], map: "platos_tool_audit_scope_tool_idx")
  @@index([organizationId, projectId, environmentId, status], map: "platos_tool_audit_scope_status_idx")
  @@index([entityId, source, createdAt(sort: Desc)], map: "platos_tool_audit_entity_source_idx")
}

/// EOBD.44 — Admin-action audit log. One row per destructive admin
/// operation (agent delete, version rollback, canary split change,
/// entity-secret rotation, memory import-replace, approval resolve,
/// skill enable/disable, initial-secret reveal, etc). Complements
/// PlatosToolCallAudit (which only covers tool dispatches).
///
/// Scope-stamped + indexed so /admin-audit views can filter by scope
/// without cross-joins. `beforeJson`/`afterJson` carry a shallow diff
/// of the subject for forensic replay; null when the action has no
/// natural "state before" (e.g. a one-shot reveal).
model PlatosAdminAudit {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// User id of the actor. `null` for system-initiated actions (e.g. a
  /// trigger.dev scheduled task rotating a secret).
  actorUserId String?

  /// Stable action slug, e.g. "agent.delete", "agent.rollback",
  /// "entity.secret.rotate", "memory.import.replace".
  action String

  /// Logical subject type + id so the audit row can be joined back to
  /// the affected resource. E.g. `subjectType = "PlatosAgent"`,
  /// `subjectId = "agt_..."`.
  subjectType String
  subjectId   String?

  /// Optional forensic snapshot. Keep payloads small; scrub secrets
  /// at the service layer before writing.
  beforeJson Json?
  afterJson  Json?

  /// Free-form reason supplied by the UI / caller ("rollback after
  /// canary regression", "rotated per compliance request", etc).
  reason String? @db.Text

  /// Source of the action for UX clarity (e.g. "ui", "api", "scheduled").
  source String?

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId, createdAt(sort: Desc)], map: "platos_admin_audit_scope_createdAt_idx")
  @@index([organizationId, projectId, environmentId, action], map: "platos_admin_audit_scope_action_idx")
  @@index([organizationId, projectId, environmentId, subjectType, subjectId], map: "platos_admin_audit_scope_subject_idx")
  @@index([organizationId, projectId, environmentId, actorUserId], map: "platos_admin_audit_scope_actor_idx")
}

/// HITL approval ledger — the durable mirror of every `request_approval` /
/// `cancel_run` waitpoint the agent opens. Scope-stamped so the
/// `/monitoring/approvals` endpoint can filter without cross-joins.
///
/// Each row is created the moment the waitpoint opens, then transitioned to
/// `approved` / `rejected` / `timed_out` as the HTTP/WS resolver pushes a
/// response onto the Redis list (or the blpop timeout expires). The SLA
/// clock is derived at read-time from (createdAt, timeoutSeconds, status).
///
/// Theme E.6.
model PlatosAgentApproval {
  id String @id @default(cuid())

  /// Stable approval key emitted to the UI — the same string that the
  /// resolve endpoint / socket event references. Unique per scope, not
  /// globally (scope prefix is part of the key but we enforce uniqueness
  /// explicitly too).
  approvalId String

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Source: `request_approval` | `cancel_run` — surface in filters so the
  /// governance dashboard can split destructive-cancel approvals from
  /// general pauses.
  source String

  agentId     String?
  threadId    String?
  /// The user who initiated the turn that opened the approval.
  requestedBy String?

  /// One-line description of what the agent is asking to do.
  action  String
  /// Optional extra context shown to the human approver.
  details String? @db.Text

  /// Lifecycle: "pending" | "approved" | "rejected" | "timed_out".
  status String @default("pending")

  /// SLA clock — how long the waitpoint will block for. Matches the value
  /// used by `request_approval` / `cancel_run` (300s default). A UI can
  /// compute remaining = max(0, timeoutSeconds - (now - createdAt)).
  timeoutSeconds Int @default(300)

  /// Populated when status leaves "pending".
  resolvedAt  DateTime?
  respondedBy String?
  comment     String?   @db.Text

  /// MCP-approval-UI — populated only by Platform MCP `require_approval`
  /// flows (when MCP_INTERACTIVE_APPROVALS=true). The waitpoint flow
  /// (`request_approval` / `cancel_run`) leaves these null and continues
  /// to mirror the Redis blpop response.
  ///   - `toolName`     fully-qualified MCP tool name (e.g. `providers.add_key`).
  ///   - `args`         redacted call arguments captured at create-time so
  ///                    the dashboard can render "what this will do".
  ///   - `requestHash`  sha256 of (scope|toolName|args). Used to dedupe
  ///                    concurrent MCP retries — a second tools/call with
  ///                    the same args returns the same approval row.
  ///   - `resolution`   structured outcome captured AFTER the operator
  ///                    approves and the tool runs successfully. Returned
  ///                    on subsequent retries so the call is idempotent.
  ///   - `consumedAt`   stamped when the tool actually executed (after
  ///                    approval). Distinguishes "approved but not yet
  ///                    re-driven by the client" from "approved + executed
  ///                    + cached".
  ///   - `requestedByMcpTokenId` mcp-token id (or oauth client hash prefix)
  ///                    that opened the approval; surfaces in the audit
  ///                    trail without leaking the bearer.
  ///   - `editedArgs`   operator-modified call arguments captured at
  ///                    resolve-time when decision = "approved_with_edits".
  ///                    The router executes the tool with these instead of
  ///                    the original `args`. Both versions are preserved
  ///                    so the audit trail shows the LLM's proposed call
  ///                    AND the operator's edited version.
  ///   - `editedByUserId` user id that edited the args. In practice the
  ///                    same as `respondedBy`, but kept as a separate
  ///                    column so a future signing-key flow can record
  ///                    "X approved Y's edits" without overloading
  ///                    `respondedBy`.
  toolName              String?
  args                  Json?
  requestHash           String?
  resolution            Json?
  consumedAt            DateTime?
  requestedByMcpTokenId String?
  editedArgs            Json?
  editedByUserId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, environmentId, approvalId])
  @@index([organizationId, projectId, environmentId, status, createdAt(sort: Desc)], map: "platos_approval_scope_status_createdAt_idx")
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_approval_scope_agent_idx")
  @@index([organizationId, projectId, environmentId, threadId], map: "platos_approval_scope_thread_idx")
  @@index([organizationId, projectId, environmentId, createdAt(sort: Desc)], map: "platos_approval_scope_createdAt_idx")
  @@index([organizationId, projectId, environmentId, requestHash], map: "platos_approval_scope_requestHash_idx")
}

/// Lightweight scope-enabled marker for LLM providers.
/// Providers are enabled in a given (org, project, env) by linking their
/// required env vars in trigger.dev's Environment Variables table. This
/// table only records the user-visible "enabled" flag + when it was linked.
/// No secrets are stored here — trigger.dev's env-var store remains the
/// single source of truth (see PLATOS_SPEC §4.4).
model PlatosProviderEnabled {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Stable manifest id: "anthropic", "openai", "google", "google-vertex", ...
  providerId String

  enabled   Boolean  @default(true)
  linkedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, environmentId, providerId])
  @@index([organizationId, projectId, environmentId])
}

/// PIFSP-14 — Multi-key provider support.
///
/// One row per named API key within a scope. The `envVarName` column holds
/// the SecretStore key (e.g. "ANTHROPIC_API_KEY_CUSTOMER_A") that is
/// resolved via `ScopedEnvService.get()` at turn-time. `isDefault = true`
/// means this key is used when no agent explicitly pins to a different key
/// (at most 1 per scope+provider). Key values are NEVER stored here — only
/// the env-var name so resolution goes through the encrypted SecretStore.
model PlatosProviderKey {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Stable manifest id: "anthropic", "openai", "google", ...
  provider   String
  /// Human-readable label (e.g. "Anthropic — Customer A").
  label      String
  /// SecretStore env-var name (e.g. "ANTHROPIC_API_KEY_CUSTOMER_A").
  envVarName String
  /// At most one per (scope, provider).
  isDefault  Boolean @default(false)

  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  @@unique([organizationId, projectId, environmentId, provider, envVarName])
  @@index([organizationId, projectId, environmentId, provider])
  @@index([organizationId, projectId, environmentId, isDefault])
}

/// Theme H.5 — Budget cap configuration.
///
/// One row per (scope, scopeType, targetId, period). `scopeType` captures the
/// billing dimension the cap applies to:
///   - "scope"  → organization/project/environment rollup (targetId = null)
///   - "agent"  → per-agent cap within the scope (targetId = agentId)
///   - "user"   → per-user cap within the scope (targetId = userId)
///
/// `period` determines the rolling window the enforcement service compares
/// against: "day" | "week" | "month". "hard-stop at 100%" is the invariant
/// (THEME_H §4) — exceeded caps block new turns until the window rolls.
/// Alerts fire at 50% / 80% / 100%, delivered via webhook + email.
///
/// Every row carries the full scope tuple per §5.1 (Theme A) even when
/// scopeType="scope" so the filter shape stays identical across all reads.
model PlatosBudgetCap {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// "scope" | "agent" | "user" — the dimension the cap applies to.
  scopeType String

  /// For scopeType="agent" this is the agent id; "user" — the userId; "scope"
  /// — empty string (kept non-null for unique-index correctness; the unique
  /// index below treats "" as the canonical scope-wide row).
  targetId String @default("")

  /// Theme SM.3 — Spend tier this cap applies to. "llm" (default) keeps every
  /// existing row governing model inference spend unchanged. "skill" gates
  /// the skill-tool dispatch path (SkillRuntimeService.checkSkillBudget).
  /// Additional tiers (e.g. "tool", "bgo") can slot in later without another
  /// migration.
  tier String @default("llm")

  /// Theme SM.3 — Optional skill-slug filter. Non-null only when tier="skill".
  /// When set, the cap applies to tool calls from that specific skill
  /// (e.g. "platos.web_search"). When null with tier="skill", the cap is a
  /// catch-all for every skill under this scope.
  skillSlug String?

  /// Theme SM.3 — Optional agent filter, orthogonal to scopeType. Non-null
  /// restricts the cap to a single agent id; null = all agents. Differs from
  /// scopeType="agent" because it composes with tier+skillSlug (e.g. "agent A
  /// spending on skill X"), whereas scopeType="agent" controls which Redis
  /// counter keys are read.
  agentId String?

  /// "day" | "week" | "month" — rolling window length.
  period String

  /// Hard limit in USD cents. Spending past this amount in the current window
  /// blocks further turns until the window rolls. `0` = soft cap (alerts only,
  /// no enforcement) — useful for rollout.
  limitCents Int

  /// Per-turn runs limit (0 = disabled). When set, counts assistant messages
  /// per window separately from cost.
  runsLimit Int @default(0)

  /// Alert thresholds as ints (50 = 50%). Stored as a JSON array so operators
  /// can tune the fire points without a migration. Default: [50, 80, 100].
  alertThresholds Json @default("[50, 80, 100]")

  /// Optional webhook URL to POST alerts to. Called by the alert task when
  /// any threshold transition fires for this cap.
  alertWebhookUrl String?

  /// Comma-separated emails (or null) to cc when alerts fire. Delivered via
  /// the trigger.dev email task path.
  alertEmails String?

  /// Admin-only override. When set to a future timestamp, a subsequent turn
  /// that would otherwise be hard-stopped is allowed through until
  /// `overrideUntil` passes. Stored so the governance dashboard can surface
  /// "bump active — expires HH:MM" without polling Redis.
  overrideUntil DateTime?
  /// Who hit the override (audit trail).
  overrideBy    String?

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PRELAUNCH-A3-6 — tier / skillSlug / agentId must be part of the
  // composite unique key so an LLM cap and a skill cap at the same
  // (scopeType, targetId, period) can coexist. The previous narrow key
  // silently aliased the second upsert onto the first row.
  // Note: tier is NOT NULL with default "llm"; skillSlug + agentId are
  // nullable. Postgres treats NULL as distinct in unique indexes (each
  // (… NULL …) row is unique vs every other (… NULL …) row), so the
  // composite key implicitly uses NULL-distinct semantics. The application
  // layer (BudgetService.upsert) explicitly passes null when unset, which
  // pairs cleanly with the COALESCE-style unique semantics intended.
  @@unique([organizationId, projectId, environmentId, scopeType, targetId, period, tier, skillSlug, agentId], map: "platos_budget_cap_scope_period_tier_uk")
  @@index([organizationId, projectId, environmentId], map: "platos_budget_cap_scope_idx")
  @@index([organizationId, projectId, environmentId, scopeType], map: "platos_budget_cap_scope_type_idx")
}

/// Theme H.1-3, H.9 — Safety detector hit ledger. One row per flagged
/// signal so the governance dashboard can render a timeline and filter by
/// detector / severity / action. Scope-stamped for §5.1 compliance.
///
/// `detector` enum-like values:
///   - "pii"         — regex + LLM assist
///   - "injection"   — prompt-injection
///   - "grounded"    — groundedness / hallucination flag
///   - "exfiltration" — unusually large output
///   - "tool_param"  — pre-tool-invoke param scan (H.9)
/// `action` — "flag" | "redact" | "block" | "warn".
model PlatosSafetyEvent {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  agentId   String?
  threadId  String?
  messageId String?
  userId    String?

  /// "pii" | "injection" | "grounded" | "exfiltration" | "tool_param"
  detector String
  /// "flag" | "redact" | "block" | "warn"
  action   String
  severity String // "low" | "medium" | "high"

  /// Free-form human detail (never includes raw matched secret text — match
  /// text is already redacted in the SafetyService before we store here).
  detail String? @db.Text
  /// Structured details: { type, pattern, confidence, model, ... }.
  meta   Json?

  /// When the detector fired on a tool call, this is the tool name + call id
  /// so the audit row can be joined to PlatosToolCallAudit.
  toolName   String?
  toolCallId String?

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId, createdAt(sort: Desc)], map: "platos_safety_scope_createdAt_idx")
  @@index([organizationId, projectId, environmentId, detector], map: "platos_safety_scope_detector_idx")
  @@index([organizationId, projectId, environmentId, threadId], map: "platos_safety_scope_thread_idx")
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_safety_scope_agent_idx")
}

/// Theme J.1 — Inline thumbs rating on an assistant message.
///
/// One row per (messageId, userId). A user flipping their vote replaces the
/// previous row via upsert; there is no history table — the aggregated
/// satisfaction metric (Theme J.2) reads the current state only.
///
/// Scope is denormalized from the parent message's thread so the aggregation
/// query in J.2 can filter by (org, project, env, agentId) with a single
/// indexed lookup. Ratings are anonymized in aggregates per Theme J invariant
/// §5 — `userId` stays on the row for audit / self-edit, but aggregate
/// queries MUST NOT surface userId to cross-user readers.
model PlatosMessageRating {
  id String @id @default(cuid())

  // Scope tuple — Theme A invariant.
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Message + thread + agent + version lock — the full chain the J.2
  // aggregator groups by. `agentVersionId` mirrors PlatosAgentThread.lockedVersionId
  // at rating time so rolling forward to a new version doesn't re-attribute
  // old ratings.
  messageId      String
  threadId       String
  agentId        String
  agentVersionId String?

  // Who cast the rating. Anonymized in aggregates.
  userId String

  // -1 (thumbs down) | 1 (thumbs up). Integer to keep neutral "remove rating"
  // a clean delete rather than a zero row.
  rating  Int
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_msg_rating_scope_agent_idx")
  @@index([organizationId, projectId, environmentId, agentVersionId], map: "platos_msg_rating_scope_ver_idx")
  @@index([threadId])
}

/// Theme J.3 — Eval criterion definition.
///
/// Per-agent rubric describing what the judge-LLM should score on. `judgePrompt`
/// is templated with the full conversation transcript at run time; `rubric`
/// is free-form scoring guidance inserted verbatim (e.g. "1=unacceptable,
/// 5=excellent, penalize hallucinations"). Criteria are versioned by
/// `updatedAt`; past `PlatosAgentEval` rows keep their `criterionSnapshot`
/// so a prompt edit doesn't retroactively shift historic scores.
///
/// Scope tuple is mandatory. Every read path in the criteria builder and
/// the dashboard filters on the full tuple (Theme J invariant §5).
model PlatosEvalCriterion {
  id String @id @default(cuid())

  // Scope
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Optional — a criterion may be scoped to a single agent or shared across
  // all agents in the env (null = shared).
  agentId String?

  // User-facing identity.
  name        String
  description String? @db.Text

  // Prompt fed to the judge LLM. `{conversation}` is substituted with the
  // serialized transcript at run time; the full prompt is saved into
  // PlatosAgentEval.judgePromptUsed so replays are reproducible.
  judgePrompt String  @db.Text
  rubric      String? @db.Text

  // Optional judge model override. Null = use env default (e.g. Claude Haiku).
  judgeModel String?

  // 0..100 score, mapped from the judge LLM's raw output by the J.4 pipeline.
  scoreScaleMin Int @default(0)
  scoreScaleMax Int @default(100)

  isActive Boolean @default(true)

  createdBy String // userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evals PlatosAgentEval[]

  @@index([organizationId, projectId, environmentId], map: "platos_eval_crit_scope_idx")
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_eval_crit_scope_agent_idx")
}

/// Theme J.5 — Judge-LLM scoring result.
///
/// One row per (conversation sample × criterion) evaluation. `score` is the
/// judge's numeric output (criterion-rescaled to 0..100). `rationale`
/// captures the judge's explanation for the score — surfaced in the J.6
/// dashboard drill-down and J.7 A/B comparison.
///
/// Scope stamped on write; every read filters by the full tuple. Judge prompt
/// + model are captured inline so replay / audit is reproducible even if the
/// criterion is later edited.
///
/// Invariant §5: the judge-LLM MUST NOT be the same model that produced the
/// conversation being scored — the pipeline blocks self-evaluation at
/// dispatch time.
model PlatosAgentEval {
  id String @id @default(cuid())

  // Scope
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Target of evaluation — usually one thread, optionally a single message.
  agentId        String
  agentVersionId String?
  threadId       String
  messageId      String?

  // Criterion that was applied.
  criterionId String
  criterion   PlatosEvalCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  // Frozen snapshot of the criterion at scoring time. Edits to the source
  // criterion never mutate this — historic trends stay truthful.
  criterionSnapshot Json

  // Raw judge output kept for transparency + debugging.
  judgeModel      String
  judgePromptUsed String  @db.Text
  rawResponse     String? @db.Text

  // Normalized scoring result.
  score     Float // 0..100 (rescaled from criterion.scoreScale{Min,Max})
  rationale String? @db.Text
  passed    Boolean @default(false) // > 50% = pass by default (overridable in UI)

  // J.8 — regression-runner bookkeeping. When a run is part of a golden-set
  // regression pass, `runId` groups the set + `baselineVersionId` records
  // what we're comparing against.
  runId             String?
  baselineVersionId String?

  // Cost accounting (the judge LLM call is itself billable).
  costCents Float?
  latencyMs Int?

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId, agentId, createdAt(sort: Desc)], map: "platos_agent_eval_scope_agent_createdAt_idx")
  @@index([organizationId, projectId, environmentId, agentVersionId], map: "platos_agent_eval_scope_ver_idx")
  @@index([organizationId, projectId, environmentId, criterionId], map: "platos_agent_eval_scope_crit_idx")
  @@index([threadId])
  @@index([runId])
}

/// Theme J.8 — Golden-set regression run.
///
/// A named collection of threads used as a stable benchmark for agent
/// versions. Running a golden set takes every thread in `threadIds`,
/// fans them through every criterion in `criterionIds`, and writes the
/// resulting `PlatosAgentEval` rows with `runId` set to this run's id.
/// The UI compares the aggregated scores against `baselineVersionId` and
/// flags regressions (any criterion averaging lower than baseline).
model PlatosGoldenSet {
  id String @id @default(cuid())

  // Scope
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  agentId String

  name        String
  description String? @db.Text

  // Thread ids that make up the set. Intentionally denormalized — threads may
  // be deleted but the golden set's "what we measured" history is preserved
  // via the captured list here and PlatosAgentEval.threadId.
  threadIds    String[]
  criterionIds String[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId, environmentId, agentId], map: "platos_golden_set_scope_agent_idx")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PLATOS SKILLS (Theme S)
//
// Skills are reusable agent behaviors packaged as (manifest + prompt-block +
// provided tools). Format is Claude-skills-compatible: a markdown file with a
// YAML frontmatter header declaring `id`, `name`, `description`, `version`,
// `required_env`, `optional_env`, `provides_tools`, etc. The prompt block is
// the markdown body.
//
// Two tables:
//   - `PlatosSkill`       — the registered manifest. Scoped to (org, project,
//                           env) unless `isOfficial` — official skills are
//                           registered at org level with a NULL projectId so
//                           every env in the org can enable them.
//   - `PlatosAgentSkill`  — join table: skill enabled on a specific agent.
//                           Inherits scope from the agent. Enablement is
//                           rejected at write time if the skill's
//                           `requiredEnv` is not all set in the target env
//                           (see SkillRegistryService.enableForAgent).
//
// Invariants (PLATOS_SPEC §10 #7, THEME_S §5):
//   - A skill registered in (org, projA, dev) cannot be enabled by an agent
//     in (org, projA, prod). The scope tuples must match exactly (or the
//     skill must be `isOfficial: true`).
//   - `requiredEnv` is checked at enable-time, NOT at runtime — fail fast.
//   - Skill prompt-block tokens are capped per agent (see THEME_S §6).
// ═══════════════════════════════════════════════════════════════════════════════

/// PIFSP-12 — Operator-authored custom tasks.
///
/// Operators write JavaScript handlers that run inside a Node vm sandbox via the
/// `platos-custom-task` trigger.dev task. The handler receives `(payload, ctx)`
/// where `ctx` exposes logger, metadata, fetch, and Platos helpers.
/// `compiledHandler` is populated on save and is the actual bytecode executed;
/// the raw `handler` string is retained for display + editing.
model PlatosTask {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Slug used as the task identifier in run_platos_task meta-tool calls.
  taskId      String
  displayName String
  description String? @db.Text

  /// "manual" | "schedule" | "webhook" | "agent-spawn"
  triggerType      String   @default("manual")
  scheduleCron     String?
  scheduleTimezone String?
  /// AES-256 encrypted webhook secret for HMAC verification.
  webhookSecret    String?
  /// Agent ids allowed to spawn this task via run_platos_task (triggerType=agent-spawn).
  allowedAgentIds  String[]

  /// JSON Schema describing the payload the handler expects.
  payloadSchema   Json?
  /// Raw JavaScript (ES2020) handler source as entered by the operator.
  handler         String  @db.Text
  /// Compiled + minified JS produced by the save endpoint. Null on first save
  /// if compilation failed (row still stored, but isActive set to false).
  compiledHandler String? @db.Text
  /// Bumped on every successful save that changes the handler source.
  handlerVersion  Int     @default(1)

  timeout    Int       @default(300) // seconds
  maxRetries Int       @default(3)
  isActive   Boolean   @default(true)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastRunAt  DateTime?

  @@unique([organizationId, projectId, environmentId, taskId])
  @@index([organizationId, projectId, environmentId])
  @@index([triggerType, isActive])
}

/// A reusable agent behavior — prompt block + provided tool schemas + required
/// env vars. Importable from claude.ai URL, a git repo, or authored inline.
/// Official skills (shipped with Platos) are org-scoped with projectId NULL so
/// every env can enable them without duplicating the row.
model PlatosSkill {
  id String @id @default(cuid())

  // Scope. Official skills set projectId + environmentId to NULL and are
  // visible to every (org, project, env) within the same organizationId.
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environmentId  String?
  environment    RuntimeEnvironment? @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Stable skill id, e.g. "platos.web_search", "acme.customer_lookup".
  /// Unique within a scope tuple.
  skillId     String
  name        String
  description String   @db.Text
  version     String   @default("0.0.1")
  author      String?
  /// "official" | "community" | "custom"
  origin      String   @default("custom")
  /// True if this skill is one of the 4 bundled ones (platos.web_search etc).
  isOfficial  Boolean  @default(false)
  /// Freeform tags for the library filter UI.
  tags        String[] @default([])
  /// Raw markdown source — the manifest + prompt block, as authored.
  source      String   @db.Text

  /// Parsed manifest — mirrors the YAML frontmatter for indexed queries /
  /// client-side filtering without re-parsing the source each time.
  ///   { id, name, description, version, author, required_env: string[],
  ///     optional_env: string[], provides_tools: Array<{name, description,
  ///     inputSchema?, outputSchema?}>, tags?: string[], importedFrom?: string }
  manifest      Json
  /// The markdown body below the frontmatter — spliced verbatim into the
  /// agent's system prompt when enabled.
  promptBlock   String   @db.Text
  /// Provided tool catalog — merged into the agent's tool registry at runtime.
  ///   Array<{ name, description, inputSchema?, outputSchema?, handler?: string }>
  providesTools Json?
  /// Env var names that MUST be set in the target env before enable succeeds.
  requiredEnv   String[] @default([])
  optionalEnv   String[] @default([])

  /// Source URL (claude.ai skill library, github, etc.) when imported.
  importedFrom String?

  enabledOnAgents PlatosAgentSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, environmentId, skillId])
  @@index([organizationId, projectId, environmentId])
  @@index([isOfficial])
  @@index([skillId])
}

/// Per-agent skill enablement. The skill's prompt-block is merged into the
/// agent's system prompt and its `providesTools` entries are merged into the
/// agent's tool catalog. Disabling is a soft flip — the row remains so
/// future re-enables don't lose config. Deleting the row cleanly removes
/// the skill from the agent.
model PlatosAgentSkill {
  id String @id @default(cuid())

  agentId String
  agent   PlatosAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillId String
  skill   PlatosSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// Scope — denormalized from agent so scope-filtered queries don't need to
  /// join. Must match the agent's (org, project, env) exactly.
  organizationId String
  projectId      String
  environmentId  String

  enabled Boolean @default(true)
  /// Per-agent per-skill config — reserved for future use (e.g. to override
  /// a tool's default model or pass a skill-level knob like max_results).
  config  Json?

  enabledAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, skillId])
  @@index([skillId])
  @@index([organizationId, projectId, environmentId])
}

/// Theme L.2 — long-term semantic memory. Polymorphic row with `kind`
/// discriminating facts / preferences / events / relationships. Always
/// user-scoped (Theme O invariant: memories belong to a specific user
/// inside a scope, not to the scope itself). Embedding is a 1536-dim
/// vector from the configured embedding provider (default
/// `text-embedding-3-small`). Prisma has no first-class support for
/// pgvector, so we declare it via `Unsupported("vector(1536)")` — reads
/// and writes that touch the column go through raw SQL in
/// `MemoryService`.
model PlatosMemory {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Optional — an agent the memory is attached to. `null` means the
  /// memory is user-scoped across all agents in the tuple.
  agentId         String?
  /// Always set. Memories are per-user even when agent-agnostic.
  userId          String
  /// FK to PlatosEndUser when known; null for legacy rows.
  platosEndUserId String?
  platosEndUser   PlatosEndUser? @relation(fields: [platosEndUserId], references: [id], onDelete: SetNull)

  /// Discriminator: "fact" | "preference" | "event" | "relationship".
  /// Enforced in application code — keeping it as a plain string lets
  /// future Theme O features extend the taxonomy without a migration.
  kind String

  content  String @db.Text
  metadata Json?

  /// pgvector embedding. Nullable so the row can be inserted before the
  /// embedding lands — the embedding pipeline back-fills asynchronously
  /// when the provider is temporarily unavailable.
  embedding Unsupported("vector(1536)")?

  /// If `false`, the recall meta-tool hides this row from the agent — the
  /// memory is editor-only (user-managed). Theme O surfaces the toggle.
  ///
  /// Theme O.6 — kept for backwards compatibility, but the authoritative
  /// signal is the `visibility` column below. Reads derive `agentVisible`
  /// from `visibility`; writes keep both in sync via MemoryService.
  agentVisible Boolean @default(true)

  /// Theme O.6 — visibility flag. One of:
  ///   "agent_visible" — the agent can recall + the UI lists it (default).
  ///   "hidden"        — the agent can still recall, but the /memories
  ///                     editor UI hides it (background facts that clutter
  ///                     the view).
  ///   "private"       — the agent CANNOT recall AND the UI hides it
  ///                     (editor-managed only; still extracted so the
  ///                     extractor can avoid re-creating the same row).
  visibility String @default("agent_visible")

  /// Provenance:
  ///   "manual"    — written by a user/editor directly.
  ///   "extracted" — derived from a conversation by the extractor (Theme O).
  ///   "imported"  — bulk-imported from an external store.
  source String

  sourceThreadId   String?
  sourceMessageIds String[]
  extractorVersion String?

  /// EOBD.46 — sha256(content) as hex. Used together with the scope
  /// tuple + sourceThreadId + userId to dedupe extractor re-runs. Null
  /// for rows created before the dedupe migration (legacy manual
  /// entries + pre-EOBD extractions); the unique constraint only
  /// fires when both sides are non-null.
  contentHash String?

  /// Theme M.1 — per-memory confidence score, 0.0 to 1.0. Set by the
  /// extractor judge LLM and bumped up/down by the ratings feedback loop
  /// (M.5). Nullable so pre-M.1 rows stay valid; recall ranking treats
  /// NULL as "unweighted" (fallback to cosine + recency only).
  confidence Float?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Bumped every time `recall` returns this row — lets Theme O rank by
  /// recency of use in addition to cosine similarity.
  lastAccessedAt DateTime?
  /// Theme MCPF-W2 — soft-delete marker. `null` = live row; non-null =
  /// archived (hidden from list/search by default, restorable via
  /// `memories.restore`). Hard delete is still available via
  /// `memories.delete` / `memories.bulk_delete`. Index is added in a
  /// separate CONCURRENT migration (partial — only stores archived rows
  /// since the read paths always filter `archivedAt IS NULL`).
  archivedAt     DateTime?

  /// EOBD.46 — dedupe extractor re-runs. Composite unique: a given
  /// (scope, user, thread, contentHash) can only exist once. Nulls in
  /// sourceThreadId or contentHash opt rows out (manual / pre-migration
  /// entries). Postgres treats NULLs as distinct by default, which is
  /// exactly what we want here.
  @@unique([organizationId, projectId, environmentId, userId, sourceThreadId, contentHash], map: "platos_mem_dedup_uniq")
  @@index([organizationId, projectId, environmentId, userId], map: "platos_mem_scope_user_idx")
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_mem_scope_agent_idx")
  @@index([organizationId, projectId, environmentId, kind], map: "platos_mem_scope_kind_idx")
  @@index([userId, createdAt(sort: Desc)], map: "platos_mem_user_created_idx")
  /// Theme M.1 — rating-weighted ranking by confidence (M.5 reader).
  @@index([organizationId, projectId, environmentId, userId, confidence], map: "platos_mem_scope_user_confidence_idx")
}

/// Theme L.3 — knowledge-graph entity. A stable node identifier plus
/// display metadata. Entities are unique per (scope, userId, entityKey)
/// — the same slug can belong to different users or different envs.
model PlatosMemoryEntity {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String

  /// L6 (audit 2026-07-16) — nullable acting-agent stamp. NULL for rows
  /// written before this column existed, or by non-agent-pinned tokens
  /// (operator MCP). Mirrors PlatosMemory.agentId so a future turn-time KG
  /// recall can filter (scope, userId, agentId) without leaking across agents.
  /// Entities are shared per (scope, userId, entityKey), so this records the
  /// FIRST agent that materialised the node (stamped on create, not update).
  agentId String?

  /// Stable external identifier chosen by the agent/operator
  /// (e.g. "user_123", "project_rocket", "company_acme"). Used as the
  /// upsert key for `relate()` so repeated calls are idempotent.
  entityKey  String
  /// "person" | "org" | "project" | "concept" | "location" | "other".
  /// Free-form so new types can be minted without schema changes.
  entityType String
  label      String
  aliases    String[]
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromRelationships PlatosMemoryRelationship[] @relation("PlatosMemoryRelationshipFrom")
  toRelationships   PlatosMemoryRelationship[] @relation("PlatosMemoryRelationshipTo")

  @@unique([organizationId, projectId, environmentId, userId, entityKey], map: "platos_mem_entity_scope_key_unq")
  @@index([organizationId, projectId, environmentId, userId], map: "platos_mem_entity_scope_user_idx")
  @@index([organizationId, projectId, environmentId, userId, agentId], map: "platos_mem_entity_scope_agent_idx")
  @@index([organizationId, projectId, environmentId, entityType], map: "platos_mem_entity_scope_type_idx")
}

/// Theme L.3 — directed edge between two `PlatosMemoryEntity` rows.
/// `relationshipType` is a free-form string ("works_at", "owns",
/// "prefers", "mentions", plus any custom label). `sourceMemoryId`
/// optionally back-links to a `PlatosMemory` row so relationships
/// derived from an extracted memory can jump back to the original
/// content.
model PlatosMemoryRelationship {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String

  /// L6 (audit 2026-07-16) — nullable acting-agent stamp, denormalised from
  /// the write scope (parallels the denormalised userId column above). NULL
  /// for pre-existing rows / non-agent-pinned tokens.
  agentId String?

  fromEntityId String
  fromEntity   PlatosMemoryEntity @relation("PlatosMemoryRelationshipFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)

  toEntityId String
  toEntity   PlatosMemoryEntity @relation("PlatosMemoryRelationshipTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  relationshipType String
  /// Optional strength indicator — e.g. 0.0..1.0 confidence, or raw
  /// interaction-count weighting for ranking. Pure application semantics.
  weight           Float?
  metadata         Json?

  /// Optional back-link to the memory row that spawned this edge (e.g.
  /// the extractor saw "alice works at acme" → created both entities
  /// + this relationship, stamped with the source memory id).
  sourceMemoryId String?

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId, userId], map: "platos_mem_rel_scope_user_idx")
  @@index([organizationId, projectId, environmentId, userId, agentId], map: "platos_mem_rel_scope_agent_idx")
  @@index([fromEntityId], map: "platos_mem_rel_from_idx")
  @@index([toEntityId], map: "platos_mem_rel_to_idx")
  @@index([organizationId, projectId, environmentId, relationshipType], map: "platos_mem_rel_scope_type_idx")
}

// ═══════════════════════════════════════════════════════════════════
// Theme K — Universal MCP Gateway
// ═══════════════════════════════════════════════════════════════════

/// Theme K — minted Platform MCP bearer tokens. Opaque random 32-byte
/// values (prefixed `plt_mcp_`) stored only as sha256. A token is
/// pinned to exactly one `(org, project, env)` tuple at mint and
/// carries an allowlist of tool-name patterns.
///
/// Validation flow: extract bearer → sha256 → lookup row → confirm
/// not revoked + not expired → bump `lastUsedAt` → build scope.
model PlatosMCPToken {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// User id of the operator who minted the token. Audit trail.
  mintedByUserId String

  /// Human-readable label shown in the tokens list ("Alice's Desktop").
  name      String
  /// sha256(raw token) — raw is returned to caller exactly once.
  tokenHash String @unique

  /// Tool-name allowlist patterns. Empty array = no tools callable
  /// (useful for audit-only tokens that can only call introspection).
  /// Glob-ish — `agents.*`, `trigger.runs.list`, `*` (everything).
  permissions String[]

  /// Theme K.18 — "scope" (default, pinned to one org/project/env) |
  /// "admin" (cross-scope within the minting org). Admin tier auto-
  /// escalates every non-block tool call to `require_approval` in the
  /// permission gateway and is only mintable by org ADMIN members.
  tier String @default("scope")

  /// Null → never expires (admin mint only). Default 90 days at mint.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId], map: "platos_mcp_token_scope_idx")
  @@index([expiresAt], map: "platos_mcp_token_expires_idx")
}

/// Theme K — registered MCP server (third-party or platos-hosted).
/// `agentId` nullable: null = org-scope install (visible to any agent
/// that binds to it via PlatosAgentMCPBinding); set = per-agent
/// private install.
model PlatosMCPServer {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Per-agent install when set; org-scope when null.
  agentId String?

  /// Unique per (scope, agentId). `slug = linear`, `slug = my-slack`.
  slug        String
  displayName String

  /// "remote-http" | "remote-sse" | "stdio" | "hosted-linear"
  /// | "hosted-slack" | "hosted-github" | "hosted-gitlab" | "hosted-notion"
  transport String

  /// Remote transports only.
  url String?

  /// stdio only. Command + args + env vars for the subprocess.
  command String?
  args    Json?
  envVars Json?

  /// SecretStore key holding API key / OAuth token / etc. The raw
  /// secret is never stored in this row.
  credsSecretKey String?

  /// When did we last succeed at `tools/list` discovery? Stale
  /// servers get flagged in the UI.
  lastDiscoveryAt DateTime?
  discoveryError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools    PlatosMCPServerTool[]
  bindings PlatosAgentMCPBinding[]

  @@unique([organizationId, projectId, environmentId, agentId, slug], map: "platos_mcp_server_uniq")
  @@index([organizationId, projectId, environmentId], map: "platos_mcp_server_scope_idx")
}

/// Theme K — cached `tools/list` entry for a registered MCP server.
/// Refreshed every 5 min by the registry service.
model PlatosMCPServerTool {
  id String @id @default(cuid())

  serverId String
  server   PlatosMCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Tool name as reported by the server. Uniqueness is per-server.
  name        String
  description String? @db.Text
  /// JSON Schema for inputs as reported by the server.
  inputSchema Json

  discoveredAt DateTime @default(now())

  @@unique([serverId, name], map: "platos_mcp_server_tool_uniq")
}

/// Theme K — per-agent toggle matrix: which MCP servers + which
/// specific tools are enabled for this agent. `enabledTools` empty
/// = NO tools enabled; use `null` to mean "all server tools enabled".
model PlatosAgentMCPBinding {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  agentId  String
  serverId String
  server   PlatosMCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// String array. Empty array = ZERO tools enabled. The app layer
  /// distinguishes "all enabled" via a nullable column would be
  /// cleaner but Prisma/Postgres `String[]` can't be nullable — so
  /// we use a separate `allToolsEnabled` boolean.
  enabledTools    String[]
  allToolsEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, projectId, environmentId, agentId, serverId], map: "platos_mcp_binding_uniq")
  @@index([organizationId, projectId, environmentId, agentId], map: "platos_mcp_binding_agent_idx")
}

/// Theme K — tier-2 MCP permission policy rows. Exact tool names or
/// glob-ish patterns map to one of three states.
model PlatosOrgMcpPolicy {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// `agents.delete` or `linear.*` or `trigger.envvars.*`.
  pattern String
  /// "auto_allow" | "require_approval" | "block"
  policy  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId, environmentId, pattern], map: "platos_mcp_policy_scope_idx")
}

/// Theme K.17 — MCP macros (record / replay / parameterize).
///
/// A `PlatosMacro` stores a recorded sequence of MCP tool calls
/// (`steps: Array<{ tool: string, params: any }>`) with `${var.path}`
/// placeholders. `macros.replay(macroId, params)` re-dispatches each
/// step through the MCP router so the same permission gate + audit
/// + scope enforcement fires as if the tool had been called directly.
///
/// `sharedWithOrg = true` makes a macro visible to every operator in
/// the same scope; otherwise only `createdBy` sees it via `macros.list`.
/// Scope is pinned at record time and never rewritten on share.
model PlatosMacro {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String

  name        String
  description String?

  /// `Array<{ tool: string, params: any }>` — params may contain
  /// `${var.path}` placeholders substituted at replay time from the
  /// caller-supplied `params` bag via the CTX.2 `resolvePath` helper.
  steps Json

  /// Optional JSON Schema describing the `params` shape `replay()` expects.
  /// Advisory for now; the runtime does not hard-validate against it.
  paramSchema Json?

  sharedWithOrg Boolean @default(false)
  createdBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId, environmentId], map: "platos_macro_scope_idx")
  @@index([createdBy], map: "platos_macro_creator_idx")
}

/// Theme K.15 — immutable platform event log. Every entry is scope-tagged
/// so SSE subscribers + persistent rules can filter cheaply. `subjectId`
/// is the runId / approvalId / budget-id / entity-id the event is about
/// (nullable for scope-wide events).
model PlatosEvent {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// `run.completed` | `run.failed` | `approval.opened` | `budget.exceeded`
  /// | `entity.disconnected` | future extensions. Dot-prefixed namespace.
  eventType String
  subjectId String?
  payload   Json

  createdAt DateTime @default(now())

  @@index([organizationId, projectId, environmentId, createdAt], map: "platos_event_scope_created_idx")
  @@index([eventType, createdAt], map: "platos_event_type_created_idx")
}

/// Theme K.15 — persistent notification routing rule. Matched events
/// dispatch to the configured `delivery` target (Slack webhook URL /
/// email / PagerDuty integration key / raw webhook). Rule CRUD sits
/// behind tier-1 `require_approval` since each rule can exfiltrate
/// scoped event data to an external system.
model PlatosNotificationRule {
  id String @id @default(cuid())

  organizationId String
  projectId      String
  environmentId  String
  environment    RuntimeEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Operator-supplied label ("on-call Slack").
  name String

  /// `{ eventTypes: string[]; subjectIds?: string[] }` — evaluated on
  /// every emit. Empty `eventTypes` matches nothing (fail-closed).
  filters Json

  /// `{ type: "slack" | "webhook" | "email" | "pagerduty"; url?: string; email?: string; integrationKey?: string }`.
  delivery Json

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  @@index([organizationId, projectId, environmentId], map: "platos_notification_rule_scope_idx")
}

/// Theme K.9 — developer-facing long-lived Platos webapp API tokens.
///
/// Distinct from `PlatosMCPToken` (MCP-only, per-scope, Theme K.1/K.7) and
/// from the legacy `PersonalAccessToken` (tr_pat_, CLI/management-API only).
/// A `PlatosPAT` authenticates AS a user against the full webapp API
/// surface — same authority as a session cookie. A PAT may be pinned to a
/// single scope tuple or left unpinned (= the user's full access).
model PlatosPAT {
  id             String    @id @default(cuid())
  /// sha256(raw token). Raw `plt_pat_...` value is returned exactly once at mint.
  tokenHash      String    @unique
  /// Human-readable label ("CI deploy bot", "Alice's laptop").
  name           String
  /// The user this PAT authenticates AS. Bearer of the raw token = that user.
  userId         String
  /// Optional scope pin. All three NULL = all scopes the user can access.
  organizationId String?
  projectId      String?
  environmentId  String?
  /// Permission tier — "admin" | "write" | "read". Defaults to "write".
  role           String    @default("write")
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, revokedAt], map: "platos_pat_user_idx")
  @@index([tokenHash], map: "platos_pat_token_hash_idx")
}

// ═══════════════════════════════════════════════════════════════════
// Theme K.10 — OAuth 2.1 + Dynamic Client Registration
// ═══════════════════════════════════════════════════════════════════

/// Theme K.10 — OAuth 2.1 client registered via RFC 7591 Dynamic Client
/// Registration. Public (PKCE-only) + confidential clients both supported.
/// Client secrets are sha256-hashed at rest; the raw secret is returned
/// once from `/oauth/register` and never again.
model PlatosOAuthClient {
  id                      String    @id @default(cuid())
  /// Opaque public client id ("plt_oac_...").
  clientId                String    @unique
  /// sha256(raw client secret). Null for public clients
  /// (token_endpoint_auth_method = "none").
  clientSecretHash        String?
  clientName              String
  redirectUris            String[]
  /// "client_secret_basic" | "client_secret_post" | "none".
  tokenEndpointAuthMethod String    @default("client_secret_basic")
  grantTypes              String[]  @default(["authorization_code", "refresh_token"])
  scope                   String?
  /// The Platos user who initiated the DCR registration. For open DCR
  /// (no auth required at /register) this is stamped "anonymous" and
  /// re-stamped to the first consenting user.
  registeredByUserId      String
  organizationId          String
  /// PIFSP-21 — per-entity OAuth client scoping. Null = legacy platform-
  /// wide client (K.10). Non-null = pinned to the PlatosConnectedEntity.id
  /// the client registered against via `/oauth/entity/:entityId/register`.
  entityPk                String?
  createdAt               DateTime  @default(now())
  /// MCPF-W3 — soft-delete marker. The `oauth.delete_client` MCP tool sets
  /// this + cascade-revokes every outstanding access/refresh token for the
  /// client. Reads on `findClient` / `verifyClientSecret` filter
  /// `deletedAt IS NULL` so a deleted client cannot be used to mint new
  /// tokens. Existing token-revocation paths (RFC 7009) are unchanged.
  deletedAt               DateTime?

  @@index([organizationId], map: "platos_oauth_client_org_idx")
  @@index([entityPk], map: "platos_oauth_client_entity_idx")
}

/// Theme K.10 — short-lived (60s) authorization code. Consumed once at
/// `/oauth/token` with the matching PKCE verifier.
model PlatosOAuthAuthCode {
  /// Opaque random code value (not hashed — one-shot + short TTL).
  code                String    @id
  clientId            String
  userId              String
  /// `{organizationId, projectId, environmentId}` the user authorized.
  scopeTuple          Json
  /// RFC 7636 code_challenge sent at /authorize.
  codeChallenge       String
  /// Only "S256" is accepted at issue time ("plain" rejected per OAuth 2.1).
  codeChallengeMethod String    @default("S256")
  redirectUri         String
  /// Space-separated scope list the user approved (may narrow the
  /// client's registered scope).
  scopes              String[]
  expiresAt           DateTime
  usedAt              DateTime?
  /// PIFSP-21 — pinned to the PlatosConnectedEntity issuing this code.
  /// Null for legacy platform-scope codes (K.10).
  entityPk            String?
  createdAt           DateTime  @default(now())

  @@index([clientId, userId], map: "platos_oauth_authcode_client_user_idx")
  @@index([expiresAt], map: "platos_oauth_authcode_expires_idx")
  @@index([entityPk], map: "platos_oauth_authcode_entity_idx")
}

/// Theme K.10 — OAuth access token. 1h default TTL. Opaque bearer with
/// `plt_oa_` prefix; sha256-stored at rest (same pattern as PlatosMCPToken).
model PlatosOAuthAccessToken {
  /// sha256(raw). Raw value is returned exactly once from /oauth/token.
  tokenHash  String    @id
  clientId   String
  userId     String
  /// `{organizationId, projectId, environmentId}`.
  scopeTuple Json
  scopes     String[]
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  /// PIFSP-21 — pinned entity for entity-scoped OAuth tokens. Null for
  /// platform-wide tokens (K.10). When non-null the MCP gateway uses
  /// this to narrow the tool matrix + stamp the audit row's `mcpUserId`.
  entityPk   String?

  @@index([clientId, userId], map: "platos_oauth_access_client_user_idx")
  @@index([expiresAt], map: "platos_oauth_access_expires_idx")
  @@index([entityPk], map: "platos_oauth_access_entity_idx")
}

/// Theme K.10 — OAuth refresh token. 90d default TTL. Rotated on use
/// (RFC 6749 §6 recommendation; OAuth 2.1 requires for public clients).
model PlatosOAuthRefreshToken {
  tokenHash       String    @id
  /// When the refresh token has been swapped for a fresh access token,
  /// link to the child hash so replayed refresh tokens can be detected.
  accessTokenHash String?
  clientId        String
  userId          String
  scopeTuple      Json
  scopes          String[]
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  /// PIFSP-21 — pinned entity, null for platform-wide refresh tokens.
  entityPk        String?

  @@index([clientId, userId], map: "platos_oauth_refresh_client_user_idx")
  @@index([expiresAt], map: "platos_oauth_refresh_expires_idx")
  @@index([entityPk], map: "platos_oauth_refresh_entity_idx")
}

/// PIFSP-22 — Anonymous MCP session. Minted when an end-user connects via
/// an entity with identityMode="anonymous". mcpUserId = "mcp:anon:<cuid>".
model PlatosMcpAnonSession {
  id          String    @id @default(cuid())
  entityPk    String
  mcpUserId   String    @unique
  firstSeenIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([entityPk, mcpUserId], map: "platos_mcp_anon_entity_user_idx")
}

/// PIFSP-22 — OIDC federated identity session. Minted after Google/GitHub/
/// custom-OIDC flow completes. mcpUserId = "mcp:oidc:<provider>:<email>".
model PlatosMcpOidcSession {
  id                   String    @id @default(cuid())
  entityPk             String
  mcpUserId            String    @unique
  provider             String
  email                String?
  emailVerified        Boolean   @default(false)
  externalSub          String
  name                 String?
  avatarUrl            String?
  /// AES-256 encrypted entity-issued access token. Forwarded as
  /// X-Platos-Entity-Token on tool dispatch so the entity can identify
  /// the real user without Platos needing to know who they are.
  entityAccessToken    String?   @db.Text
  /// AES-256 encrypted entity-issued refresh token. Used to rotate
  /// entityAccessToken when it expires without re-asking the user.
  entityRefreshToken   String?   @db.Text
  entityTokenExpiresAt DateTime?
  firstLoginAt         DateTime  @default(now())
  lastLoginAt          DateTime?
  revokedAt            DateTime?

  @@index([entityPk, mcpUserId], map: "platos_mcp_oidc_entity_user_idx")
  @@index([entityPk, email], map: "platos_mcp_oidc_entity_email_idx")
}

/// PIFSP-25 — Per-tool MCP ACL. Default exposed=false (safest).
/// toolAllowlist on PlatosEntityMcpConfig is a denorm cache of toolName
/// where exposed=true — kept in sync by mcp-tool-acl.service.ts.
model PlatosEntityMcpToolAcl {
  id              String    @id @default(cuid())
  entityPk        String
  toolId          String
  toolName        String
  exposed         Boolean   @default(false)
  /// "anonymous" | "oidc" | "bearer" (default bearer = safest)
  minIdentityMode String    @default("bearer")
  allowedPatIds   String[]  @default([])
  scopeLabels     String[]  @default(["mcp:tools"])
  addedBy         String
  addedAt         DateTime  @default(now())
  lastReviewedAt  DateTime?

  @@unique([entityPk, toolId])
  @@index([entityPk, exposed])
}

/// PIFSP-22 — Bearer PAT for service-to-service MCP access.
/// Raw token shown once; stored as sha256 hash.
/// mcpUserId = "mcp:pat:<id>" (operator-overridable).
model PlatosMcpBearerToken {
  id         String    @id @default(cuid())
  entityPk   String
  tokenHash  String    @unique
  label      String
  mcpUserId  String
  scopes     String[]  @default(["mcp:tools"])
  createdBy  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([tokenHash], map: "platos_mcp_bearer_hash_idx")
  @@index([entityPk, revokedAt], map: "platos_mcp_bearer_entity_idx")
}
