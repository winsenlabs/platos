  userId String?

  /// Time filter settings used when the query was executed
  /// Period like "7d", "24h", etc.
  filterPeriod String?
  /// Custom start date (ISO 8601)
  filterFrom   DateTime?
  /// Custom end date (ISO 8601)
  filterTo     DateTime?

  createdAt DateTime @default(now())

