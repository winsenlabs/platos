# Copy to `.env` and fill in from the dashboard.

# `PLATOS_URL` is the WebSocket endpoint the entity connects to.
# Local dev: ws://localhost:3100/tools/sync
# Staging:   wss://test.platos.dev/tools/sync
# Prod:      wss://play.platos.dev/tools/sync
PLATOS_URL=wss://test.platos.dev/tools/sync

# `PLATOS_SECRET` is the `serviceSecret` shown ONCE on the
# `/agent-entities/new` screen. If you lost it, use Regenerate on the
# entity detail page.
PLATOS_SECRET=

# `PLATOS_ENV` pins the WebSocket connection to a specific Platos
# environment. Without it, the agent's WS handler falls back to
# DEVELOPMENT and the entity will appear "disconnected" when viewed
# under Production. Accepts: production | staging | preview | development
# (or the exact RuntimeEnvironment id).
PLATOS_ENV=production

# Upstream MCP server to mirror. Default points at the public Platos
# docs MCP — leave it as-is to bridge `search_docs` into your Platos
# instance. Change to any other MCP URL to bridge that one instead.
MCP_UPSTREAM_URL=https://mcp.platos.dev/mcp

# Optional auth for the upstream MCP. Leave empty for the public docs
# MCP. For protected MCPs, supply a `Bearer ...` token (or a full
# `Authorization: Bearer ...` header). OAuth 2.1 with DCR is not
# auto-handled here — for those, complete the handshake out-of-band
# and paste the resulting access token.
MCP_UPSTREAM_AUTH_HEADER=

# How often to re-fetch the upstream tool catalog. Default 10 minutes.
# Lower this if you want new upstream tools to appear faster; raise it
# if you're rate-limited.
MCP_TOOLS_REFRESH_MS=600000
