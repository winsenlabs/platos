{
  "name": "platos",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "turbo run build",
    "build:v1": "tsc -b tsconfig.json",
    "clean:v1": "node scripts/arch/clean-v1.mjs",
    "build:force": "turbo run build --force",
    "build:platos": "pnpm run build:platos:agent && pnpm run build:platos:webapp",
    "build:platos:agent": "pnpm --filter @platos/tenancy-database build && pnpm --filter @internal/docs build && pnpm --filter platos-agent build:strict && pnpm --filter platos-agent audit:production-dependencies",
    "build:platos:webapp": "pnpm --filter @platos/tenancy-database build && node apps/webapp/scripts/memory-policy.mjs build -- pnpm exec turbo run build --filter='webapp' --concurrency=1",
    "build:db:seed": "turbo run build:db:seed",
    "db:migrate": "turbo run db:migrate:deploy generate",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "db:populate": "turbo run db:populate",
    "dev": "turbo run dev",
    "i:dev": "infisical run -- turbo run dev",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "audit:scope": "node scripts/audit-scope.mjs",
    "audit:win253-clickhouse-split": "node scripts/clickhouse-split-audit.mjs --check",
    "test:win253-clickhouse-split": "node --test scripts/clickhouse-split-audit.test.mjs",
    "audit:win253-vendored-build": "node scripts/vendored-build-audit.mjs",
    "test:win253-vendored-build": "node --test scripts/vendored-build-audit.test.mjs",
    "audit:platos-build": "node scripts/audit-platos-build.mjs",
    "audit:route-parity": "node scripts/route-capability-parity.mjs",
    "audit:route-parity:completion": "node scripts/route-capability-parity.mjs --completion",
    "audit:route-parity:completion:evidence": "node scripts/route-capability-completion-audit.mjs",
    "generate:route-parity": "node scripts/route-capability-parity.mjs --write",
    "audit:vocabulary": "node scripts/vocabulary-boundary.mjs",
    "test:vocabulary": "node --test scripts/vocabulary-boundary.test.mjs scripts/vocabulary/ledger.test.mjs",
    "audit:docs-examples": "node scripts/docs-examples.mjs",
    "test:docs-examples": "node --test scripts/docs-examples.test.mjs",
    "generate:workspace-reachability": "node scripts/workspace-reachability.mjs generate",
    "audit:workspace-reachability": "node scripts/workspace-reachability.mjs check",
    "test:workspace-reachability": "node --test scripts/workspace-reachability.test.mjs",
    "generate:root-manifest": "node scripts/root-entry-manifest.mjs --write",
    "audit:root-manifest": "node scripts/root-entry-manifest.mjs --check",
    "test:root-manifest": "node --test scripts/root-entry-manifest.test.mjs",
    "audit:hook-policy": "node scripts/hook-policy.mjs",
    "test:hook-policy": "node --test scripts/hook-policy.test.mjs",
    "test": "turbo run test --concurrency=1 -- --run",
    "test:route-parity": "node --test scripts/route-capability-parity.test.mjs",
    "test:route-parity:completion:evidence": "node --test scripts/route-capability-completion-audit.test.mjs",
    "test:ci-policy": "node --test scripts/ci-policy.test.mjs",
    "test:win-290": "pnpm --filter platos-agent exec vitest run src/shared/clickhouse-deadline.test.ts src/monitoring/spans.clickhouse-deadline.test.ts src/monitoring/span-dlq.test.ts src/monitoring/trace-request-abort.test.ts --no-file-parallelism",
    "test:win-290:redis": "pnpm --filter platos-agent exec vitest run src/monitoring/spans.dlq.redis.test.ts",
    "test:webapp": "turbo run test --filter webapp -- --run",
    "test:packages": "turbo run test --concurrency=1 --filter \"./packages/**\" -- --run",
    "test:internal": "turbo run test --concurrency=1 --filter \"@internal/*\" -- --run",
    "test:dev": "turbo run test:dev",
    "start": "turbo run start",
    "check-exports": "turbo run check-exports",
    "clean": "turbo run clean",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "typecheck": "turbo run typecheck",
    "typecheck:persisted-state:integration": "pnpm --filter webapp exec tsc --noEmit -p tsconfig.persisted-state-gate.json",
    "test:persisted-state:integration": "pnpm --filter webapp exec vitest run test/persistedStateGate.integration.test.ts",
    "test:persisted-state:artifacts": "node tests/persisted-state-gate/verify-artifacts.mjs",
    "test:persisted-state:performance": "node tests/persisted-state-gate/run-performance.mjs",
    "test:persisted-state:performance-artifacts": "node tests/persisted-state-gate/verify-performance-artifacts.mjs",
    "test:persisted-state:performance-contract": "node --test scripts/deploy-platos.test.mjs tests/persisted-state-gate/candidate-identity-contract.test.mjs tests/persisted-state-gate/measured-response.test.mjs tests/persisted-state-gate/operator-session-cookie.test.mjs tests/persisted-state-gate/release-authorization-contract.test.mjs tests/persisted-state-gate/scheduled-query-window.test.mjs tests/persisted-state-gate/verify-performance-artifacts.test.mjs",
    "test:release-authorization:contract": "node --test scripts/deploy-platos.test.mjs tests/persisted-state-gate/release-authorization-contract.test.mjs",
    "test:non-browser-completion": "node tests/persisted-state-gate/run-non-browser-evidence.mjs",
    "test:non-browser-completion:contract": "node --test tests/persisted-state-gate/run-non-browser-evidence.test.mjs tests/persisted-state-gate/verify-non-browser-evidence.test.mjs",
    "test:browser-evidence": "playwright test --config=tests/browser-evidence/playwright.config.ts",
    "test:browser-evidence:artifacts": "node tests/browser-evidence/verify-artifacts.mjs",
    "test:browser-evidence:contract": "pnpm exec vitest run tests/browser-evidence/contracts.test.ts && node --test tests/browser-evidence/verify-artifacts.test.mjs",
    "seed:persisted-state": "tsx tests/persisted-state-gate/seed.ts",
    "test:postgres-memory:evidence": "node tests/postgres-memory-evidence/run.mjs",
    "test:postgres-memory:artifacts": "node tests/postgres-memory-evidence/verify-artifacts.mjs",
    "test:postgres-memory:contract": "node --test tests/postgres-memory-evidence/*.test.mjs && pnpm --filter platos-agent exec vitest run src/memory/postgres-integration-evidence.test.ts --no-file-parallelism",
    "provision:postgres-memory:evidence": "node tests/postgres-memory-evidence/provision-sentinel.mjs",
    "setup": "turbo run generate db:migrate:force db:seed",
    "env:pull": "turbo run env:pull",
    "changeset:add": "changeset",
    "changeset:status": "changeset status",
    "clean:sourcemaps": "turbo run clean:sourcemaps",
    "storybook": "turbo run storybook",
    "audit:advisory": "node scripts/audit-advisory.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:sbom": "node scripts/audit-sbom.mjs generate",
    "audit:sbom:check": "node scripts/audit-sbom.mjs check",
    "audit:sbom:nonvacuity": "node scripts/verify-sbom-nonvacuity.mjs",
    "test:sbom": "node --test scripts/audit-sbom.test.mjs",
    "audit:arch-boundaries": "node scripts/arch/arch-boundaries.mjs && node scripts/arch/gen-dependency-cruiser.mjs --check",
    "test:arch-boundaries": "node --test scripts/arch/arch-boundaries.test.mjs",
    "audit:v1-project-graph": "node scripts/arch/v1-project-graph.mjs",
    "test:v1-project-graph": "node --test scripts/arch/v1-project-graph.test.mjs",
    "test:gen-v1-skeleton": "node --test scripts/arch/gen-v1-skeleton.test.mjs",
    "test:clean-v1": "node --test scripts/arch/clean-v1.test.mjs",
    "test:v1-foundation": "pnpm test:gen-v1-skeleton && pnpm test:clean-v1",
    "audit:max-file-lines": "node scripts/arch/max-file-lines.mjs",
    "test:max-file-lines": "node --test scripts/arch/max-file-lines.test.mjs",
    "test:install-git-hooks": "node --test scripts/install-git-hooks.test.mjs",
    "audit:contract-map": "node scripts/arch/contract-map.mjs",
    "audit:capability-matrix": "node scripts/capability-matrix.mjs --check"
  },
  "devDependencies": {
    "@manypkg/cli": "^0.19.2",
    "@platos/database": "workspace:*",
    "@playwright/test": "^1.36.2",
    "@remix-run/node": "2.1.0",
    "@types/node": "20.14.14",
    "@vitest/coverage-v8": "3.1.4",
    "autoprefixer": "^10.4.12",
    "eslint-plugin-turbo": "^2.0.4",
    "lefthook": "1.11.3",
    "pkg-types": "1.1.3",
    "prettier": "^3.0.0",
    "tsx": "^3.7.1",
    "turbo": "^1.10.3",
    "typescript": "5.5.4",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.0.5",
    "vitest": "3.1.4",
    "yaml": "2.6.1"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@changesets/cli": "2.26.2",
    "agentcrumbs": "^0.5.0",
    "node-fetch": "2.6.x"
  },
  "pnpm": {
    "patchedDependencies": {
      "@changesets/assemble-release-plan@5.2.4": "patches/@changesets__assemble-release-plan@5.2.4.patch",
      "engine.io-parser@5.2.2": "patches/engine.io-parser@5.2.2.patch",
      "graphile-worker@0.16.6": "patches/graphile-worker@0.16.6.patch",
      "redlock@5.0.0-beta.2": "patches/redlock@5.0.0-beta.2.patch",
      "@sentry/remix@9.46.0": "patches/@sentry__remix@9.46.0.patch",
      "@upstash/ratelimit@1.1.3": "patches/@upstash__ratelimit.patch",
      "@window-splitter/state@0.4.1": "patches/@window-splitter__state@0.4.1.patch"
    },
    "overrides": {
      "typescript": "5.5.4",
      "@types/node": "20.14.14",
      "express@^4>body-parser": "1.20.3",
      "@remix-run/dev@2.1.0>tar-fs": "2.1.3",
      "testcontainers@10.28.0>tar-fs": "3.0.9",
      "form-data@^2": "2.5.4",
      "form-data@^3": "3.0.4",
      "form-data@^4": "4.0.4",
      "axios@1.9.0": ">=1.12.0",
      "js-yaml@>=3.0.0 <3.14.2": "3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": "4.1.1",
      "jws@<3.2.3": "3.2.3",
      "qs@>=6.0.0 <6.14.1": "6.14.1",
      "systeminformation@>=5.0.0 <5.27.14": "5.27.14",
      "lodash@>=4.0.0 <4.17.23": "4.17.23"
    },
    "onlyBuiltDependencies": [
      "@depot/cli",
      "@fingerprintjs/fingerprintjs-pro-react",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "@swc/core",
      "better-sqlite3",
      "cpu-features",
      "esbuild",
      "lefthook",
      "prisma",
      "protobufjs",
      "re2",
      "sharp",
      "ssh2",
      "turbo"
    ]
  }
}
