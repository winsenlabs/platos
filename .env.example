# ─────────────────────────────────────────────────────────────
# REQUIRED SECRETS — replace the dev values below with real ones
# before production.
#
# Generator recipes (macOS + Linux):
#
#   SESSION_SECRET / MAGIC_LINK_SECRET:
#     openssl rand -base64 24 | tr -d '\n'      # any length OK
#
#   ENCRYPTION_KEY / PLATOS_ENCRYPTION_KEY / PLATOS_MESSAGE_ENCRYPTION_KEY /
#   roots inside PLATOS_CREDENTIAL_ROOT_KEYS:
#     openssl rand -hex 32                      # produces 64 hex chars
#     Generate a different value for every encryption domain.
#     Existing exact 32-byte UTF-8 ENCRYPTION_KEY values remain supported;
#     never replace one without first re-encrypting its historical ciphertext.
# ─────────────────────────────────────────────────────────────
SESSION_SECRET=abcdef1234-replace-with-real-secret
MAGIC_LINK_SECRET=abcdef1234-replace-with-real-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # New installs: 64 hex chars. Existing 32-byte UTF-8 values remain valid.
# WIN-293 — REQUIRED control-plane trust anchor shared by the webapp and the
# agent (compose passes the SAME value to both services). The webapp sends it
# as X-Platos-Internal-Auth on every server-to-server call; the agent grants the
# "operator" tier over its direct-header channel ONLY for callers that present
# it. If unset, compose refuses to boot and the webapp fails fast at startup —
# there is no unauthenticated operator fallback. Generate with:
#     openssl rand -hex 32                        # min 16 chars; 64 hex recommended
PLATOS_INTERNAL_AUTH_TOKEN=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# ─────────────────────────────────────────────────────────────
# Platos agent — REQUIRED for compose to boot.
# Values below are `deadbeef`-style sentinels that pass the format
# checks so local dev boots zero-config. ROTATE BEFORE PROD.
# ─────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes). Agent `secrets.service.ts:31` validates
# keyHex.length === 64 + Buffer.from(keyHex, "hex"). Replace with
# `openssl rand -hex 32` for prod.
PLATOS_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
PLATOS_ERASURE_HASH_SALT=dev-erasure-hash-salt-change-before-production
# How long an erased subject stays refused on the write path. Must outlive the
# longest reference that could still land a write for them — a live session, an
# in-flight durable task, the 30-day ClickHouse span TTL. Floored at 1 day.
PLATOS_ERASURE_TOMBSTONE_TTL_DAYS=30
# How many times the queue re-drives an erasure whose store did not settle
# before leaving it for an operator. Exhausting the count does not abandon the
# operation — the receipt, the resume plan and the retry route all survive; it
# only stops an automated ninth pass that would teach nobody anything.
PLATOS_ERASURE_MAX_RETRIES=8
# Platos-native Environment credential envelope root-key ring. This domain is
# independent of ENCRYPTION_KEY, PLATOS_ENCRYPTION_KEY, message keys, and auth
# secrets. The active version must be a positive integer present in the JSON
# root map. Retain prior roots only while active envelopes reference them.
# Generate every root independently with `openssl rand -hex 32`.
PLATOS_CREDENTIAL_ROOT_KEY_VERSION=1
PLATOS_CREDENTIAL_ROOT_KEYS='{"1":"feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface"}'
# EOBD.23 — message-at-rest encryption key (AES-256-GCM). REQUIRED
# for SPEC §5.13 encrypted-conversation compliance. 64 hex chars (32
# bytes), same format as PLATOS_ENCRYPTION_KEY but a DIFFERENT value
# so a compromise of one key doesn't decrypt both. Generate with:
#   openssl rand -hex 32
# Rotation is one-way: old ciphertext unreadable without the previous
# key (see docs/encryption-rotation.md when you rotate — planned).
# Leave the sentinel unchanged for local dev; replace before prod.
PLATOS_MESSAGE_ENCRYPTION_KEY=cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe
PLATOS_MESSAGE_ENCRYPTION_KEY_V=1

# ─────────────────────────────────────────────────────────────
# LLM provider credentials — at least one required to run an agent turn.
#
# Create and link credentials in the dashboard Providers page for each
# Environment. Bare references include names such as ANTHROPIC_API_KEY. Scoped provider,
# health, embedding, and MCP resolution never falls back to process.env.
# Deployment provider env vars are therefore intentionally not listed here.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Embeddings — REQUIRED for memory + RAG features.
#
# Without a linked OPENAI_API_KEY or VOYAGE_API_KEY dashboard credential,
# EVERY memory write
# (including the hourly `MemoryExtractionScheduler` cron) throws.
# Symptoms: agent looks "stateless across sessions"; memory tab is
# empty even after multi-turn conversations; agent logs show
# `OPENAI_API_KEY not configured` or `VOYAGE_API_KEY not configured`.
#
# Pick ONE provider; both work, neither is auto-detected. Voyage is the
# default. The default model on each provider is
# 1536-dim native to fit the existing pgvector column without a
# schema migration; switching models / dims later requires a
# migration of the `PlatosMemory.embedding` column.
# ─────────────────────────────────────────────────────────────
PLATOS_EMBEDDING_PROVIDER=voyage   # `voyage` (recommended) or `openai`
PLATOS_EMBEDDING_MODEL=             # blank → default per provider (voyage-large-2 / text-embedding-3-small)
# Link VOYAGE_API_KEY or OPENAI_API_KEY in the dashboard for this Environment.

# ─────────────────────────────────────────────────────────────
# Platform MCP — interactive approval queue (opt-in).
# When `true`, mutating MCP tools (require_approval tier) open a real
# PlatosAgentApproval row + return -32002 AWAITING_APPROVAL with the
# approval id. Operator approves in the dashboard `/approvals` page,
# then the client retries the same call with `X-Platos-Approval-Id:
# <id>` to get the executed result. Leave unset/false for the OSS
# default (auto-approve, matches today's behaviour).
# ─────────────────────────────────────────────────────────────
# MCP_INTERACTIVE_APPROVALS=false
# MCP_APPROVAL_TTL_SECONDS=3600   # SLA window in seconds (default 1h)

# ─────────────────────────────────────────────────────────────
# Service passwords — REQUIRED for compose to boot.
# Dev defaults below are known-weak. Override before exposing externally.
# ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=password

# Agent and webapp share one canonical clean database.
POSTGRES_DB=platos_control

# MinIO — override root creds in prod; agent startup warns loudly if defaults remain.
# MINIO_ROOT_USER=platos-minio-admin
# MINIO_ROOT_PASSWORD=platos-minio-password
LOGIN_ORIGIN=http://localhost:3030
# EOBD.59 — derive password from POSTGRES_PASSWORD above. Hardcoding
# `postgres` would silently break when operators customise POSTGRES_PASSWORD.
# NOTE on interpolation: docker-compose + Prisma's dotenv both expand
# `${VAR}` references. Plain Node `dotenv` does NOT — if you ever load
# `.env` directly via `dotenv.config()`, wire `dotenv-expand` too, OR
# paste the resolved password into DATABASE_URL here.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/platos_control?schema=public
# This sets the URL used for direct connections to the database and should only be needed in limited circumstances
# See: https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#fields:~:text=the%20shadow%20database.-,directUrl,-No
DIRECT_URL=${DATABASE_URL}
REMIX_APP_PORT=3030
APP_ENV=development
APP_ORIGIN=http://localhost:3030
ELECTRIC_ORIGIN=http://localhost:3060
NODE_ENV=development

# Webapp memory policy. The runtime default keeps V8 old-space at 1536 MiB
# under the default 2 GiB container limit; startup rejects overrides that leave
# less than 25% / 512 MiB for native memory and request buffers.
# WEBAPP_MEM_LIMIT=2g
# WEBAPP_NODE_MAX_OLD_SPACE_SIZE_MB=1536
# Local/container builds default to a 1536 MiB heap and require another
# 2048 MiB to be available. Build off-box when that headroom is unavailable.
# WEBAPP_BUILD_MAX_OLD_SPACE_SIZE_MB=1536
# Production source maps materially increase Remix peak memory and are off by
# default. Enable only on an off-box builder with extra measured headroom.
# WEBAPP_BUILD_SOURCEMAPS=false

# Clickhouse
CLICKHOUSE_URL=http://default:password@localhost:8123
CLICKHOUSE_DATABASE=platos_telemetry
PLATOS_TELEMETRY_DATABASE=platos_telemetry
PLATOS_OBSERVABILITY_MAX_RETRIES=10
RUN_REPLICATION_CLICKHOUSE_URL=http://default:password@localhost:8123
RUN_REPLICATION_ENABLED=1

# Set this to UTC because Node.js uses the system timezone
TZ="UTC"

# Redis is used for the v3 queuing and v2 concurrency control
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_TLS_DISABLED="true"

DEV_OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:3030/otel"
DEV_OTEL_BATCH_PROCESSING_ENABLED="0"

# When the domain is set to `localhost` the CLI deploy command will only --load the image by default and not --push it
DEPLOY_REGISTRY_HOST=localhost:5000

# OPTIONAL VARIABLES
# This is used for validating emails that are allowed to log in. Every email that do not match this regex will be rejected.
# WHITELISTED_EMAILS="^(authorized@yahoo\.com|authorized@gmail\.com)$"
# Accounts with these emails will get global admin rights. This grants access to the admin UI.
# ADMIN_EMAILS="^(admin@example\.com|another-admin@example\.com)$"
# This is used for logging in via GitHub. You can leave these commented out if you don't want to use GitHub for authentication.
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# Configure an email transport to allow users to sign in to Trigger.dev via a Magic Link.
# If none are configured, emails will print to the console instead.
# Uncomment one of the following blocks to allow delivery of

# Resend
### Visit https://resend.com, create an account and get your API key. Then insert it below along with your From and Reply To email addresses. Visit https://resend.com/docs for more information.
# EMAIL_TRANSPORT=resend
# FROM_EMAIL=
# REPLY_TO_EMAIL=
# RESEND_API_KEY=

# Generic SMTP
### Enter the configuration provided by your mail provider. Visit https://nodemailer.com/smtp/ for more information
### SMTP_SECURE = false will use STARTTLS when connecting to a server that supports it (usually port 587)
# EMAIL_TRANSPORT=smtp
# FROM_EMAIL=
# REPLY_TO_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# AWS Simple Email Service
### Authentication is configured using the default Node.JS credentials provider chain (https://docs.aws.amazon.com/AWSJavaScriptSDK/v3/latest/Package/-aws-sdk-credential-providers/#fromnodeproviderchain)
# EMAIL_TRANSPORT=aws-ses
# FROM_EMAIL=
# REPLY_TO_EMAIL=

# CLOUD VARIABLES
POSTHOG_PROJECT_KEY=

# DEPOT_ORG_ID=<Depot org id>
# DEPOT_TOKEN=<Depot org token>
# DEV_OTEL_EXPORTER_OTLP_ENDPOINT="http://0.0.0.0:4318"
# These are needed for the object store (for handling large payloads/outputs)
#
# Default provider
# OBJECT_STORE_BASE_URL=http://localhost:9005
# OBJECT_STORE_BUCKET=packets
# OBJECT_STORE_ACCESS_KEY_ID=minioadmin
# OBJECT_STORE_SECRET_ACCESS_KEY=minioadmin
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_SERVICE=s3
#
# OBJECT_STORE_DEFAULT_PROTOCOL=s3  # Only specify this if you're going to migrate object storage and set protocol values below
# Named providers (protocol-prefixed data) - optional for multi-provider support
# OBJECT_STORE_S3_BASE_URL=https://s3.amazonaws.com
# OBJECT_STORE_S3_ACCESS_KEY_ID=
# OBJECT_STORE_S3_SECRET_ACCESS_KEY=
# OBJECT_STORE_S3_REGION=us-east-1
# OBJECT_STORE_S3_SERVICE=s3
#
# OBJECT_STORE_R2_BASE_URL=https://{bucket}.{accountId}.r2.cloudflarestorage.com
# OBJECT_STORE_R2_ACCESS_KEY_ID=
# OBJECT_STORE_R2_SECRET_ACCESS_KEY=
# OBJECT_STORE_R2_REGION=auto
# OBJECT_STORE_R2_SERVICE=s3
# CHECKPOINT_THRESHOLD_IN_MS=10000

# ─────────────────────────────────────────────────────────────
# Platos Theme D — multimodal attachments (MinIO)
# ─────────────────────────────────────────────────────────────
# The default docker-compose.platos.yml stands up a MinIO instance
# and creates the bucket automatically. Override these only if
# you're pointing at external S3.
# MINIO_ROOT_USER=platos-minio-admin
# MINIO_ROOT_PASSWORD=platos-minio-password
# MINIO_ENDPOINT=http://minio:9000
# MINIO_PUBLIC_ENDPOINT=http://localhost:9001
# MINIO_BUCKET=platos-media
# MINIO_REGION=us-east-1
# PLATOS_ATTACHMENT_MAX_BYTES=104857600        # per-upload (100MB)
# PLATOS_ATTACHMENT_ORG_QUOTA_BYTES=10737418240 # per-org (10GB)
# PLATOS_ATTACHMENT_PRESIGN_TTL_SECONDS=900     # short-lived PUT capability
# PLATOS_ATTACHMENT_GRACE_DAYS=7               # unattached upload TTL
# PLATOS_ATTACHMENT_TTL_DAYS=30                # attached-message TTL

# OSS launch — hard cap on org members + pending invites. The hosted
# demo enforces 2; self-hosters bump this to whatever fits their team.
# Set the same value on both webapp + agent (this var is read by both)
# so REST + MCP `org.add_member` + webapp invites all enforce it.
# PLATOS_MAX_PROJECT_MEMBERS=2

# ─────────────────────────────────────────────────────────────
# External Trigger — optional durable agent dispatch.
# ─────────────────────────────────────────────────────────────
# Trigger runs as a separate application. There is no local Trigger worker or
# endpoint default. Leave BOTH values unset for direct-turn dispatch, or set
# BOTH explicitly for Trigger Cloud / a separately deployed self-hosted
# Trigger.dev instance.
# TRIGGER_API_URL=https://api.trigger.dev
# TRIGGER_API_URL=https://trigger.example.com
# TRIGGER_SECRET_KEY=tr_prod_replace_me
# Setting only one value is treated as incomplete config: the agent logs why
# durable dispatch is disabled and continues to serve direct turns.

# PLATOS_COMPONENT_AUTH_SECRET: shared HMAC secret between Platos components
# its trigger.dev task workers. Generate with: openssl rand -hex 32
# Leave unset in local dev (uses insecure default + warns at boot).
# REQUIRED in production — the compose file uses :? syntax to enforce this.
PLATOS_COMPONENT_AUTH_SECRET=   # Required in production: openssl rand -hex 32

# External Trigger task concurrency is configured in the external Trigger
# deployment. These values bound Platos-owned task handlers.
# PLATOS_WORKER_CONCURRENCY=50           # platos-agent-tool-block queue cap
# PLATOS_BATCH_CONCURRENCY=20            # platos-agent-batch queue cap
# PLATOS_CUSTOM_TASK_CONCURRENCY=10      # platos-custom-task queue cap
# PLATOS_PER_ORG_CONCURRENCY=100         # per-org spawn_job queue cap
# PLATOS_PER_ORG_BATCH_CONCURRENCY=20    # per-org agent_batch queue cap
# PLATOS_BATCH_ITEM_CONCURRENCY=5        # parallel items within a single batch run

# These control the server-side internal telemetry
# INTERNAL_OTEL_TRACE_EXPORTER_URL=<URL to send traces to>
# INTERNAL_OTEL_TRACE_LOGGING_ENABLED=1
# INTERNAL_OTEL_TRACE_INSTRUMENT_PRISMA_ENABLED=0

# Enable local observability stack (requires `pnpm run docker` to start otel-collector)
# Uncomment these to send metrics to the local Prometheus via OTEL Collector:
# INTERNAL_OTEL_METRIC_EXPORTER_ENABLED=1
# INTERNAL_OTEL_METRIC_EXPORTER_URL=http://localhost:4318/v1/metrics

# ─────────────────────────────────────────────────────────────
# Platos docs MCP bridge (optional sidecar) — wires the public docs MCP at
# https://mcp.platos.dev/mcp into this Platos instance as a connected entity
# named `platos-docs-mcp` (default). Until the agent runtime ships native
# external-MCP consumption (roadmap: "Consume external MCP servers"), this
# is the way to bring `search_docs` into agents in this scope.
#
# Setup:
#   1. In the dashboard, register a new entity (e.g. `platos-docs-mcp`).
#   2. Copy the service secret shown ONCE on creation. If you missed it, click
#      Regenerate on the entity detail page — fresh value displays once.
#   3. Paste it into PLATOS_DOCS_MCP_BRIDGE_SECRET below.
#   4. `docker compose -f docker-compose.platos.yml up -d docs-mcp-bridge`.
#
# Leave PLATOS_DOCS_MCP_BRIDGE_SECRET empty to keep the sidecar off — the
# container starts but exits cleanly without connecting (no resource cost).
# ─────────────────────────────────────────────────────────────
PLATOS_DOCS_MCP_BRIDGE_SECRET=

# Optional overrides — most operators leave these defaulted.
# PLATOS_DOCS_MCP_BRIDGE_PLATOS_URL=ws://agent:3100/tools/sync
# PLATOS_DOCS_MCP_BRIDGE_ENV=production                     # production | staging | preview | development (default: production)
# PLATOS_DOCS_MCP_BRIDGE_UPSTREAM_URL=https://mcp.platos.dev/mcp
# PLATOS_DOCS_MCP_BRIDGE_UPSTREAM_AUTH=                     # `Bearer xxx` for protected upstream MCPs
# PLATOS_DOCS_MCP_BRIDGE_REFRESH_MS=600000                  # how often to re-fetch tools/list
# INTERNAL_OTEL_METRIC_EXPORTER_INTERVAL_MS=15000
