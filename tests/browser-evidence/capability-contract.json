  "paginationContracts": {
    "postman-template-crud": {
      "pageParam": "page",
      "pageSizeParam": "pageSize",
      "resultSelector": "form:has(input[name=\"templateId\"])",
      "rowIdentity": {
        "selector": "input[name=\"templateId\"]",
        "source": "value"
      },
      "totalSelector": "nav[aria-label=\"Postman template pagination\"] [role=\"status\"]",
      "totalPattern": "of\\s+([\\d,]+)",
      "minTotal": 3
    },
    "mcp-token-list": {
      "pageParam": "page",
      "pageSizeParam": "pageSize",
      "resultSelector": "section:has-text(\"Platform token inventory\") tbody tr",
      "rowIdentity": {
        "selector": "input[name=\"tokenId\"]",
        "source": "value"
      },
      "totalSelector": "body",
      "totalPattern": "Scoped tokens\\s+([\\d,]+)",
      "minTotal": 3
    },
    "entity-mcp-bearer-token-list": {
      "pageParam": "tokenPage",
      "pageSizeParam": "tokenPageSize",
      "resultSelector": "section:has-text(\"Entity bearer inventory\") tbody tr",
      "rowIdentity": {
        "selector": "input[name=\"tokenId\"]",
        "source": "value"
      },
      "totalSelector": "section:has-text(\"Entity bearer inventory\")",
      "totalPattern": "([\\d,]+)\\s+total",
      "minTotal": 3
    },
    "mcp-tool-acl-policy": {
      "pageParam": "aclPage",
      "pageSizeParam": "aclPageSize",
      "resultSelector": "section:has-text(\"Environment Tool ACL\") form:has(input[name=\"toolId\"])",
      "rowIdentity": {
        "selector": "input[name=\"toolId\"]",
        "source": "value"
      },
      "totalSelector": "section:has-text(\"Environment Tool ACL\")",
      "totalPattern": "([\\d,]+)\\s+filtered Tools",
      "minTotal": 3
    },
    "message-pagination": {
      "pageParam": "page",
      "pageSizeParam": "pageSize",
      "resultSelector": "main > article:has(code)",
      "rowIdentity": {
        "selector": "code",
        "source": "text"
      },
      "totalSelector": "nav[aria-label=\"Thread message pagination\"] [role=\"status\"]",
      "totalPattern": "of\\s+([\\d,]+)",
      "minTotal": 3
    },
    "thread-artifacts": {
      "pageParam": "artifactPage",
      "pageSizeParam": "artifactPageSize",
      "resultSelector": "section:has-text(\"Artifacts\") article",
      "rowIdentity": {
        "selector": "h3",
        "source": "text"
      },
      "totalSelector": "nav[aria-label=\"Thread artifact pagination\"] [role=\"status\"]",
      "totalPattern": "of\\s+([\\d,]+)",
      "minTotal": 3
    }
  },
  "targetOverrides": {
    "route-014": "environment/agent-connect",
    "route-057": "environment/memories",
    "route-071": "organization/settings/team",
    "route-078": "embed",
    "route-079": "embed",
    "route-083": "root",
    "route-084": "root"
  }
}
