{
  "name": "@platosdev/client",
  "version": "0.1.2",
  "description": "Official Platos JavaScript/TypeScript client SDK — agents, threads, realtime streaming, approvals, budgets.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/winsenlabs/platos",
    "directory": "packages/platos-client"
  },
  "homepage": "https://github.com/winsenlabs/platos/tree/main/packages/platos-client#readme",
  "bugs": {
    "url": "https://github.com/winsenlabs/platos/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "socket.io-client": "4.7.4"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "keywords": [
    "platos",
    "agents",
    "llm",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  }
}
