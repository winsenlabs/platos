{
  "name": "@platos/context-tools",
  "version": "0.0.0",
  "private": true,
  "description": "ADR M0.3 bounded context: tools.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/contracts/index.js",
  "types": "./dist/contracts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./application/ports/index.js": {
      "types": "./dist/application/ports/index.d.ts",
      "import": "./dist/application/ports/index.js"
    },
    "./application/testing/index.js": {
      "types": "./dist/application/testing/index.d.ts",
      "import": "./dist/application/testing/index.js"
    },
    "./adapters/index.js": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@platos/kernel": "workspace:*",
    "@platos/context-tenancy": "workspace:*",
    "@platos/context-identity-access": "workspace:*",
    "@platos/context-secrets": "workspace:*",
    "@platos/context-providers": "workspace:*",
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "3.25.76"
  }
}
