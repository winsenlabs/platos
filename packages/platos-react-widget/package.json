{
  "name": "@platosdev/react-widget",
  "version": "0.2.0",
  "description": "React FAB chat widget for Platos agents — drop-in chat bubble with streaming, identity collection (form / preset / OTP-verified), theming, and full per-turn pass-through (dynamicBlocks, modelLabel, sessionContext, attachments).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/winsenlabs/platos",
    "directory": "packages/platos-react-widget"
  },
  "homepage": "https://github.com/winsenlabs/platos/tree/main/packages/platos-react-widget#readme",
  "bugs": {
    "url": "https://github.com/winsenlabs/platos/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@platosdev/client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "5.6.3",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "keywords": [
    "platos",
    "react",
    "chat",
    "widget",
    "fab",
    "agent",
    "streaming"
  ],
  "publishConfig": {
    "access": "public"
  }
}
