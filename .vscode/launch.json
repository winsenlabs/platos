{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug webapp",
      "command": "pnpm --filter webapp dev",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug opened test file",
      "command": "pnpm test -- ./${relativeFile}",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Chrome webapp",
      "url": "http://localhost:3030",
      "webRoot": "${workspaceFolder}/apps/webapp/app"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug Run Queue test",
      "command": "pnpm test ./src/run-queue/index.test.ts --run",
      "cwd": "${workspaceFolder}/internal-packages/run-engine",
      "sourceMaps": true
    }
  ]
}
