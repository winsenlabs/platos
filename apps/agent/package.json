{
  "name": "platos-agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:strict": "tsc --outDir dist --declaration && node scripts/enforce-production-auth-boundary.mjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test:trigger-bundle": "vitest run scripts/trigger-worker-externals.test.ts",
    "audit:trigger-boundary": "vitest run src/trigger-tasks/deployment-boundary-manifest.test.ts",
    "test:trigger-cutover": "node --test scripts/trigger-cutover-plan.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest"
  },
