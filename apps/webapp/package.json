{
  "private": true,
  "name": "webapp",
  "version": "1.0.0",
  "sideEffects": false,
  "scripts": {
    "audit:production-dependencies": "node ./scripts/audit-production-dependencies.mjs",
    "build": "node ./scripts/memory-policy.mjs build -- pnpm run build:components",
    "build:components": "run-s build:remix build:server build:sentry && pnpm run upload:sourcemaps && pnpm run audit:production-dependencies -- --build-output",
    "build:remix": "node ./scripts/build-remix.mjs",
    "build:server": "esbuild --platform=node --format=cjs ./server.ts --outdir=build --sourcemap",
    "build:sentry": "esbuild --platform=node --format=cjs ./sentry.server.ts --outdir=build --sourcemap",
    "dev": "cross-env PORT=3030 remix dev -c \"node ./build/server.js\"",
    "dev:worker": "cross-env NODE_PATH=../../node_modules/.pnpm/node_modules node ./build/server.js",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "cross-env NODE_ENV=production node ./scripts/memory-policy.mjs runtime -- node ./build/server.js",
    "start:local": "node ./scripts/memory-policy.mjs runtime -- node ./build/server.js",
    "typecheck": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit -p ./tsconfig.check.json",
    "upload:sourcemaps": "bash ./upload-sourcemaps.sh",
    "clean:sourcemaps": "find ./build ./public/build -type f -name '*.map' -delete 2>/dev/null || true",
    "test": "pnpm run test:production-dependencies && vitest --no-file-parallelism",
    "test:production-dependencies": "node --test ./scripts/audit-production-dependencies.test.mjs ./scripts/restore-patches.test.mjs",
    "eval:dev": "evalite watch"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build"
  ],
  "dependencies": {
    "@internal/workload-identity": "workspace:*",
    "@platos/tenancy-database": "workspace:*",
    "@remix-run/express": "2.1.0",
    "@remix-run/node": "2.1.0",
    "@remix-run/react": "2.1.0",
    "@sentry/remix": "9.46.0",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "express": "4.20.0",
    "lucide-react": "^0.229.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "react-resizable": "^3.1.3",
    "socket.io-client": "4.7.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@remix-run/dev": "2.1.0",
    "@remix-run/eslint-config": "2.1.0",
    "@remix-run/testing": "^2.1.0",
    "@sentry/cli": "2.50.2",
    "@swc/core": "^1.3.4",
    "@swc/helpers": "^0.4.11",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@total-typescript/ts-reset": "^0.4.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cookie": "^0.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/eslint": "^8.4.6",
    "@types/express": "^4.17.13",
    "@types/humanize-duration": "^3.27.1",
    "@types/json-query": "^2.2.3",
    "@types/lodash.omit": "^4.5.7",
    "@types/marked": "^4.0.3",
    "@types/morgan": "^1.9.3",
    "@types/node-fetch": "^2.6.2",
    "@types/prismjs": "^1.26.0",
    "@types/qs": "^6.9.7",
    "@types/react": "18.2.69",
    "@types/react-collapse": "^5.0.4",
    "@types/react-dom": "18.2.7",
    "@types/regression": "^2.0.6",
    "@types/seedrandom": "^3.0.8",
    "@types/semver": "^7.5.0",
    "@types/simple-oauth2": "^5.0.4",
    "@types/slug": "^5.0.3",
    "@types/supertest": "^6.0.2",
    "@types/tar": "^6.1.4",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "autoevals": "^0.0.130",
    "autoprefixer": "^10.4.13",
    "css-loader": "^6.10.0",
    "datepicker": "link:@types/@react-aria/datepicker",
    "engine.io": "^6.5.4",
    "esbuild": "^0.15.10",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-turbo": "^2.0.4",
    "evalite": "^0.11.4",
    "npm-run-all": "^4.1.5",
    "postcss-import": "^16.0.1",
    "postcss-loader": "^8.1.1",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "prop-types": "^15.8.1",
    "rimraf": "^3.0.2",
    "style-loader": "^3.3.4",
    "supertest": "^7.0.0",
    "tailwind-scrollbar": "^3.0.1",
    "tailwind-scrollbar-hide": "^1.1.7",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.5",
    "tailwindcss-textshadow": "^2.1.3",
    "tsconfig-paths": "^3.14.1",
    "tsx": "^4.20.6",
    "typescript": "5.5.4",
    "vite-tsconfig-paths": "^4.0.5",
    "vitest": "3.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
