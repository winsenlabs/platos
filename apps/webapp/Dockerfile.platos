ARG NODE_IMAGE=node:22-bullseye-slim

FROM golang:1.23-alpine AS goose_builder
RUN go install github.com/pressly/goose/v3/cmd/goose@v3.26.0

FROM ${NODE_IMAGE} AS pruner

WORKDIR /triggerdotdev

COPY --chown=node:node . .
RUN npx -q turbo@2.5.4 prune --scope=webapp --docker
RUN find . -name "node_modules" -type d -prune -exec rm -rf '{}' +

# Base strategy to have layer caching
FROM ${NODE_IMAGE} AS base
# git: needed by lefthook postinstall
# python3 + make + g++: needed by native deps (better-sqlite3, cpu-features, etc.)
RUN apt-get update && apt-get install -y openssl dumb-init git python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /triggerdotdev
COPY --chown=node:node .gitignore .gitignore
COPY --from=pruner --chown=node:node /triggerdotdev/out/json/ .
COPY --from=pruner --chown=node:node /triggerdotdev/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner --chown=node:node /triggerdotdev/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --chown=node:node patches ./patches
# `turbo prune --docker` strips `pnpm.patchedDependencies` from the
# pruned root package.json, leaving an empty `{}` — which means pnpm
# install silently skips every patch even though the patches/ dir was
# copied in above. Restore the field from the original root
# package.json so patches actually apply during install.
#
# Filter to only patches whose target package appears in the pruned
# lockfile — turbo prune drops deps that aren't reachable from the
# webapp's dep tree, so blindly keeping every patch trips
# ERR_PNPM_UNUSED_PATCH on install.
COPY --chown=node:node package.json /tmp/orig-root-package.json
COPY --chown=node:node apps/webapp/scripts/restore-patches.cjs /tmp/restore-patches.cjs
RUN node /tmp/restore-patches.cjs /tmp/orig-root-package.json package.json pnpm-lock.yaml \
    && rm /tmp/orig-root-package.json /tmp/restore-patches.cjs

## Dev deps
FROM base AS dev-deps
WORKDIR /triggerdotdev
# Corepack is used to install pnpm with the exact version from packageManager
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
ENV NODE_ENV=development
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --no-frozen-lockfile
# Generate Prisma client here where all deps are installed
COPY --from=pruner --chown=node:node /triggerdotdev/internal-packages/tenancy-database/prisma /triggerdotdev/internal-packages/tenancy-database/prisma
RUN cd /triggerdotdev/internal-packages/tenancy-database && pnpx prisma@6.14.0 generate --schema prisma/schema.prisma

## Production deps
FROM base AS production-deps
WORKDIR /triggerdotdev
# Corepack is used to install pnpm with the exact version from packageManager
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
ENV NODE_ENV=production
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --prod --no-frozen-lockfile

## Builder (builds the webapp)
FROM base AS builder
# This is needed for the sentry-cli binary while building the webapp
RUN apt-get update && apt-get install -y openssl dumb-init ca-certificates
WORKDIR /triggerdotdev
# Corepack is used to install pnpm with the exact version from packageManager
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate

ARG SENTRY_RELEASE
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG BUILD_GIT_SHA
ARG WEBAPP_BUILD_MAX_OLD_SPACE_SIZE_MB=1536
ARG WEBAPP_BUILD_SOURCEMAPS=false
ENV SENTRY_RELEASE=${SENTRY_RELEASE} \
    SENTRY_ORG=${SENTRY_ORG} \
    SENTRY_PROJECT=${SENTRY_PROJECT} \
    BUILD_GIT_SHA=${BUILD_GIT_SHA} \
    WEBAPP_BUILD_MAX_OLD_SPACE_SIZE_MB=${WEBAPP_BUILD_MAX_OLD_SPACE_SIZE_MB} \
    WEBAPP_BUILD_SOURCEMAPS=${WEBAPP_BUILD_SOURCEMAPS}

# Goose and schemas
COPY --from=goose_builder /go/bin/goose /usr/local/bin/goose
RUN chmod +x /usr/local/bin/goose
COPY --chown=node:node internal-packages/clickhouse/schema /triggerdotdev/internal-packages/clickhouse/schema

COPY --from=pruner --chown=node:node /triggerdotdev/out/full/ .
COPY --from=dev-deps --chown=node:node /triggerdotdev/ .
COPY --chown=node:node turbo.json turbo.json
COPY --chown=node:node apps/webapp/scripts ./scripts
RUN chmod +x ./scripts/wait-for-it.sh
RUN chmod +x ./scripts/entrypoint.sh
COPY --chown=node:node .configs/tsconfig.base.json .configs/tsconfig.base.json
COPY --chown=node:node scripts/updateVersion.ts scripts/updateVersion.ts
# The explicit webapp graph intentionally includes its current deferred engine
# dependencies. The memory wrapper serializes that graph, caps V8 old-space at
# 1.5 GiB by default, and refuses to build unless another 2 GiB is available.
# A ~7.9 GiB host with only ~3 GiB available therefore fails safely instead of
# threatening the running services. Source maps are opt-in because Remix's map
# generation has materially higher peak memory. Production images should be
# built off-box. Opted-in release builds upload maps to Sentry and delete every
# map from build/public before the runtime image is assembled.
RUN --mount=type=secret,id=sentry_auth_token \
    SENTRY_AUTH_TOKEN=$(cat /run/secrets/sentry_auth_token 2>/dev/null || true) \
    pnpm run build:platos:webapp

# Runner
FROM ${NODE_IMAGE} AS runner
RUN apt-get update && apt-get install -y openssl netcat-openbsd ca-certificates
WORKDIR /triggerdotdev
ENV NODE_ENV=production

COPY --from=base /usr/bin/dumb-init /usr/bin/dumb-init
COPY --from=pruner --chown=node:node /triggerdotdev/out/full/ .
COPY --from=production-deps --chown=node:node /triggerdotdev .
# Copy the generated canonical control-plane client.
COPY --from=dev-deps --chown=node:node /triggerdotdev/internal-packages/tenancy-database/generated ./internal-packages/tenancy-database/generated
COPY --from=builder --chown=node:node /triggerdotdev/apps/webapp/build/server.js ./apps/webapp/build/server.js
COPY --from=builder --chown=node:node /triggerdotdev/apps/webapp/build ./apps/webapp/build
COPY --from=builder --chown=node:node /triggerdotdev/apps/webapp/public ./apps/webapp/public
COPY --from=builder --chown=node:node /triggerdotdev/scripts ./scripts

# Goose and schemas
COPY --from=builder /usr/local/bin/goose /usr/local/bin/goose
COPY --from=builder --chown=node:node /triggerdotdev/internal-packages/clickhouse/schema /triggerdotdev/internal-packages/clickhouse/schema

# Phase 3 — docs + guides catalog. The publicDocs.server.ts loader walks
# from cwd (here `/triggerdotdev`) looking for `content/docs` +
# `content/guides`. Turbo prune (in the pruner stage) only follows
# workspace packages, so `content/` is missing from `out/full/`. Pull
# it directly from the pruner's pre-prune working tree where the
# original repo is still intact.
COPY --from=pruner --chown=node:node /triggerdotdev/content /triggerdotdev/content
ENV PLATOS_DOCS_CONTENT_ROOT=/triggerdotdev

# Build info
ARG BUILD_APP_VERSION
ARG BUILD_GIT_SHA
ARG SENTRY_RELEASE
ARG BUILD_GIT_REF_NAME
ARG BUILD_TIMESTAMP_SECONDS
ENV BUILD_APP_VERSION=${BUILD_APP_VERSION} \
    BUILD_GIT_SHA=${BUILD_GIT_SHA} \
    SENTRY_RELEASE=${SENTRY_RELEASE} \
    BUILD_GIT_REF_NAME=${BUILD_GIT_REF_NAME} \
    BUILD_TIMESTAMP_SECONDS=${BUILD_TIMESTAMP_SECONDS}

EXPOSE 3000

# Add global pnpm shims and install pnpm during build (root user)
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate

USER node

# Ensure pnpm is installed during build and not silently downloaded at runtime (node user)
RUN corepack prepare pnpm@10.23.0 --activate

CMD ["./scripts/entrypoint.sh"]
